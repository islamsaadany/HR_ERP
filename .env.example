# --- Database (Neon Postgres) ---
# Pooled connection (runtime)
POSTGRES_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct connection (Prisma migrations / db push)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- NextAuth (v5) ---
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32+char-random-string"
# Local only; Vercel auto-detects in production
# NEXTAUTH_URL="http://localhost:3000"

# --- Temporary username/password login (bridge until Google OAuth is live) ---
# A single bootstrap admin can sign in with these. On first login the app upserts
# this account as an active SUPER_USER. CHANGE THE PASSWORD before real use, and
# remove this bridge once Google SSO is configured. Defaults (if unset): Islam / 1234.
BOOTSTRAP_ADMIN_USERNAME="Islam"
BOOTSTRAP_ADMIN_PASSWORD="1234"
BOOTSTRAP_ADMIN_EMAIL="islam.saadany@forefront.consulting"
BOOTSTRAP_ADMIN_NAME="Islam"

# --- Google OAuth (optional) ---
# When BOTH are set, a "Continue with Google" button appears on the sign-in page.
# Leave blank to hide it and use only the username/password login above.
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# --- Access control ---
# Domain allowed to sign in (no @)
ALLOWED_EMAIL_DOMAIN="forefront.consulting"
# Comma-separated bootstrap admins (Super User)
ADMIN_EMAILS="islam.saadany@forefront.consulting"

# --- File storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN="vercel-blob-rw-token"

# --- Email notifications (Resend — spec 020) ---
# Claim-workflow emails (HR/Finance/employee). SECRETS — set in Vercel, never commit.
# With RESEND_API_KEY unset the whole email subsystem is inert: claims still work,
# no email is attempted. The HR/Finance inbox addresses and on/off toggle are set
# in-app (Super User → notification settings), NOT here.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sender address (the display name comes from the in-app from-name).
EMAIL_FROM="hr@forefront.consulting"
