// HR_ERP — Prisma schema
// Foundation module (spec 001): employee registry, roles, dependants, personal documents.
// Later modules add their own models. Real employee PII is seeded via prisma/sql/ files
// that are kept OUT of git (see .gitignore).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  EMPLOYEE
  HR_ADMIN
  SUPER_USER
  FINANCE // confirms benefit-claim payments (spec 020); SUPER_USER is a superset
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

// Four confirmed tenure bands (drive Benefits pool ceilings)
enum TenureBand {
  BAND_6MO_2Y // 6 months – 2 years
  BAND_2_4Y // 2 – 4 years
  BAND_4_7Y // 4 – 7 years
  BAND_7_10Y // 7 – 10 years
}

enum EmployeeStatus {
  ACTIVE
  LEFT
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

/// The employee registry — the backbone every module reads from.
model User {
  id       String  @id @default(cuid())
  email    String  @unique // login identity (Google, company domain)
  name     String
  photoUrl String?

  // Public directory fields
  phone      String?
  department String?
  title      String?

  // Authorization
  role Role @default(EMPLOYEE)

  // Email + password sign-in (scrypt hash; null = password not set, Google-only).
  passwordHash       String?
  // Set true when HR issues a temporary password; the employee is gated to
  // /set-password on next sign-in until they choose their own compliant one.
  mustChangePassword Boolean @default(false)

  // Set when the employee first dismisses/finishes the Benefits orientation tour (spec 017);
  // stops it auto-opening again. The "How it works" button ignores this.
  benefitsOrientationSeenAt DateTime?

  // HR-private employment fields (money-affecting: HR-set, authoritative)
  employmentType EmploymentType?
  tenureBand     TenureBand?
  startDate      DateTime?
  endDate        DateTime?
  status         EmployeeStatus  @default(ACTIVE)
  monthlySalary  Int? // HR-private; used for the Loans benefit ceiling (up to one month)

  // HR-private personal fields
  dateOfBirth   DateTime?
  maritalStatus MaritalStatus?

  // Emergency contact (HR-managed; shown read-only on the employee's own Profile, never the Directory)
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  // Reporting line (org chart) — self relation
  reportsToId String?
  reportsTo   User?   @relation("Reports", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports     User[]  @relation("Reports")

  // Business unit (multi-brand, spec 024) — HR-managed; drives which brand this
  // user sees. Optional; null = the default brand. Distinct from `department`.
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)

  // Employee ID (spec 025) — HR-managed PERSON identifier. Optional and NOT unique:
  // a person holding two contracts is two accounts sharing one Employee ID, which
  // links them for the account switcher. Email stays the unique per-account login.
  employeeId String?

  dependants Dependant[]

  // Personal documents owned by this user
  documents         PersonalDocument[] @relation("DocOwner")
  uploadedDocuments PersonalDocument[] @relation("DocUploader")

  // Onboarding
  onboardingCompletions ActivityCompletion[]

  // Time-off
  leaveRequests  LeaveRequest[] @relation("LeaveRequester")
  leaveApprovals LeaveRequest[] @relation("LeaveApprover")

  // Benefits
  medicalCommitments MedicalCommitment[] @relation("MedicalOwner")
  committedMedical   MedicalCommitment[] @relation("MedicalCommitter")
  benefitClaims      BenefitClaim[]      @relation("ClaimOwner")
  reviewedClaims     BenefitClaim[]      @relation("ClaimReviewer")
  paidClaims         BenefitClaim[]      @relation("ClaimPayer")
  benefitReleases    BenefitRelease[]    @relation("ReleaseSubject")
  releasesGiven      BenefitRelease[]    @relation("ReleaseActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([status])
  @@index([reportsToId])
  @@index([businessUnitId])
  @@index([employeeId])
}

/// A dependant of an employee — name + DOB, and a kind (CHILD or SPOUSE). Age is derived, never stored.
/// The spouse is a dependant (kind = SPOUSE) so medical can price it by age like a child (spec 023).
model Dependant {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  dateOfBirth DateTime
  kind        DependantKind @default(CHILD)
  createdAt   DateTime      @default(now())

  medicalCoverage MedicalCoveredPerson[]

  @@index([userId])
}

/// Distinguishes a covered spouse from a child on a Dependant (spec 023). At most one SPOUSE per user.
enum DependantKind {
  CHILD
  SPOUSE
}

/// A personal document owned by one employee (ID, certificate, contract, HR letter).
/// Visible to the owner and HR/Super User only. Company-wide files live in Handbook & Resources.
model PersonalDocument {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation("DocOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  blobUrl      String
  contentType  String?
  sizeBytes    Int?
  uploadedById String?
  uploadedBy   User?    @relation("DocUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([ownerId])
}

// ─── Onboarding (spec 002) ──────────────────────────────────────────────

enum ActivityType {
  POLICY // read & acknowledge
  ACTION // do & complete
}

enum OnboardingTrackKey {
  COMMON_CORE // everyone
  CONSULTING // Consulting role track
}

/// An onboarding activity — the unit a joiner acknowledges (Policy) or completes (Action).
model OnboardingActivity {
  id          String               @id @default(cuid())
  title       String
  description String?
  type        ActivityType
  stage       String // free-text group label, e.g. "Week 1", "Check-ins"
  track       OnboardingTrackKey   @default(COMMON_CORE)
  linkUrl     String? // deep link into another module or a resource
  order       Int                  @default(0)
  active      Boolean              @default(true)
  completions ActivityCompletion[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([track, stage, order])
}

/// A joiner's self-attested acknowledgement/completion of an activity.
model ActivityCompletion {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId  String
  activity    OnboardingActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  completedAt DateTime           @default(now())

  @@unique([userId, activityId])
  @@index([userId])
}

// ─── Knowledge Base (spec 008) ──────────────────────────────────────────

/// A knowledge-base article ("read") authored in Markdown. Grouped by a
/// free-text category; body supports GFM + [!CALLOUT] blocks + mermaid.
model KnowledgeArticle {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  cluster        String? // top-level grouping (e.g. "Consulting"); category = topic within it
  category       String
  summary        String?
  body           String   @default("") // markdown (front-matter stripped)
  readingMinutes Int?
  attachmentUrl  String? // optional deck (PDF) shown/embedded under the article body
  attachmentName String? // original filename, used as the download label
  attachmentType String? // MIME type (v1: application/pdf)
  attachmentSize Int? // bytes
  published      Boolean  @default(true)
  order          Int      @default(0)
  authorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([published])
}

// ─── Handbook & Resources (spec 004) ────────────────────────────────────

/// A browsable, searchable handbook section (native content).
model HandbookSection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String?
  body        String   @default("") // markdown/plain text
  actionLabel String? // optional CTA button (e.g. "Request time off")
  actionHref  String? // …linking to the matching tool/module
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

/// A downloadable company file (company profile, template, policy, …).
model Resource {
  id           String   @id @default(cuid())
  title        String
  category     String   @default("Other")
  blobUrl      String
  contentType  String?
  sizeBytes    Int?
  uploadedById String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([category])
}

// ─── Time-Off / Leave (spec 005) ────────────────────────────────────────

enum LeaveStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

/// A time-off request (full days). Approved by the requester's direct manager
/// (or a Super User when none exists). No balances/types in v1.
model LeaveRequest {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  note            String?
  status          LeaveStatus @default(PENDING)
  approverId      String?
  approver        User?       @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decisionComment String?
  decidedAt       DateTime?
  // Null once a decision (approve/decline) is made and not yet seen by the requester;
  // set when the requester views their Time-Off page. Drives the nav badge (FR-014).
  decisionSeenAt  DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([approverId, status])
}

// ─── Benefits (spec 007) ────────────────────────────────────────────────

enum PlanYearStatus {
  OPEN
  CLOSED
}

/// What an employee must provide to claim/reimburse a benefit.
enum ClaimType {
  NONE // paid automatically — no request needed
  NOTE // request with an optional note/description
  PROOF // mandatory proof-of-payment upload, reviewed before release
}

// Spec 020 staged workflow: Submitted (awaiting HR) → Approved (awaiting Finance
// payment) → Reimbursed (paid); Rejected is terminal from Submitted. (The legacy
// spec-018 PENDING/RELEASED values were retired by migration 031.)
enum ClaimStatus {
  SUBMITTED
  APPROVED
  REIMBURSED
  REJECTED
}

/// A benefits cycle. Employees can save/submit only while OPEN.
model PlanYear {
  id                 String              @id @default(cuid())
  name               String
  status             PlanYearStatus      @default(OPEN)
  /// Proration window (spec 019). Admin-set; nullable for legacy rows / fallback.
  /// When either is null the year is treated as having no window → no proration.
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime            @default(now())
  medicalCommitments MedicalCommitment[]
  claims             BenefitClaim[]
  releases           BenefitRelease[]
}

/// Pool ceiling per (employment type × tenure band). Max claimable for the year.
model PoolCeiling {
  id             String         @id @default(cuid())
  employmentType EmploymentType
  tenureBand     TenureBand
  amount         Int

  @@unique([employmentType, tenureBand])
}

/// A fixed/guaranteed benefit. One row per benefit (spec 021): eligibility is a pair of
/// flags (Full-time / Part-time) shown in the unified Benefits Catalogue, and amounts are
/// held per employment type × tenure band (ft* / pt* columns) on the numbers-only Amounts tab.
/// Superseded the old "one row per (benefit × employmentType)" model.
model GuaranteedBenefit {
  id               String           @id @default(cuid())
  name             String
  note             String?
  /// Grouping category shown in the unified catalogue (spec 021), aligned with the flexible
  /// benefit categories (e.g. "Life & family", "Personal growth"). Distinct from `note` (a short
  /// description). Null falls back to "Other".
  category         String?
  /// Who this benefit is available to. Drives what each employee sees by their employment type.
  eligibleFullTime Boolean          @default(true)
  eligiblePartTime Boolean          @default(true)
  /// Full-time amounts per tenure band (null = salary-driven / not set).
  ftBand6mo2y      Int?
  ftBand2to4y      Int?
  ftBand4to7y      Int?
  ftBand7to10y     Int?
  /// Part-time amounts per tenure band (null = salary-driven / not set).
  ptBand6mo2y      Int?
  ptBand2to4y      Int?
  ptBand4to7y      Int?
  ptBand7to10y     Int?
  order            Int              @default(0)
  claimType        ClaimType        @default(NOTE)
  /// Whether this guaranteed benefit's annual budget is prorated for mid-year
  /// starters (spec 019). True only for Professional development; event/season
  /// gifts (marriage, summer, special events, loans) stay false = full-when-triggered.
  prorated         Boolean          @default(false)
  claims           BenefitClaim[]
  releases         BenefitRelease[]
}

/**
 * A per-employee record that a fixed-allowance guaranteed benefit was released for a plan year
 * (spec 013). Presence of a row = "Released"; absence = "Not released". `amount` snapshots the
 * band-derived figure at release time. Salary-driven benefits (Loans) are never released here.
 */
model BenefitRelease {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation("ReleaseSubject", fields: [userId], references: [id], onDelete: Cascade)
  guaranteedBenefitId String
  guaranteedBenefit   GuaranteedBenefit @relation(fields: [guaranteedBenefitId], references: [id], onDelete: Cascade)
  planYearId          String
  planYear            PlanYear          @relation(fields: [planYearId], references: [id], onDelete: Cascade)
  amount              Int
  releasedAt          DateTime          @default(now())
  releasedById        String?
  releasedBy          User?             @relation("ReleaseActor", fields: [releasedById], references: [id], onDelete: SetNull)

  @@unique([userId, guaranteedBenefitId, planYearId])
  @@index([guaranteedBenefitId, planYearId])
}

/// Managed list of valid department names (HR-editable, spec 014). The employee's
/// `department` stays a text label on User; this table is the source of choices/filters.
/// Renaming a department cascades to matching User.department values; a department can
/// only be removed while no employee is assigned to it. Not a foreign key.
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

/// Age-banded medical rate card (spec 023). One row per age band; premium is looked up by a covered
/// person's age. `tier` allows more tiers later — only Tier 1 exists today. Amounts carry two decimals
/// (the operator quotes cents); employee-facing figures drop the cents (truncate).
model MedicalRateBand {
  id            String  @id @default(cuid())
  tier          Int     @default(1)
  minAge        Int
  maxAge        Int?
  annualPremium Decimal @db.Decimal(10, 2)
  order         Int     @default(0)

  @@unique([tier, minAge])
  @@index([tier])
}

/// Medical cover scope (spec 021). Personal = the employee only; Family = employee + spouse + children.
enum MedicalScope {
  PERSONAL
  FAMILY
}

/// A selectable flexible-basket category. Medical is special (rate-card priced, cap-exempt).
model BenefitCatalogItem {
  id               String         @id @default(cuid())
  key              String         @unique
  name             String
  description      String?
  category         String?
  isMedical        Boolean        @default(false)
  /// For medical items only (spec 021): PERSONAL (self) or FAMILY (self + dependants). Null for non-medical.
  medicalScope     MedicalScope?
  /// Who this benefit is available to. Drives what each employee sees by their employment type.
  eligibleFullTime Boolean        @default(true)
  eligiblePartTime Boolean        @default(true)
  order            Int            @default(0)
  active           Boolean        @default(true)
  claimType        ClaimType      @default(PROOF)
  /// Company coverage rate, percent 0–100 (spec 012). The covered (company) share = cost × rate/100
  /// draws from the pool; the employee pays the remainder. Medical is 100% (cost = covered).
  coverageRate     Int            @default(100)
  claims           BenefitClaim[]
}

/// An employee's committed medical election for a plan year (spec 018) — the single commitment in
/// the flexible-benefits module. Existence of the row means medical is committed. The employee
/// cannot edit or remove it after committing; only HR (admin) may, as an exception. Flexible
/// benefits have no selection/allocation record — they are claimed directly (see BenefitClaim).
model MedicalCommitment {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation("MedicalOwner", fields: [userId], references: [id], onDelete: Cascade)
  planYearId      String
  planYear        PlanYear               @relation(fields: [planYearId], references: [id], onDelete: Cascade)
  /// LEGACY (spec 023): the old relationship-based selection. Nullable, no longer written for new
  /// commits — retained so historical rows keep their record. Superseded by `coveredPeople`.
  spouse          Boolean?
  childrenUnder18 Int?
  children18Plus  Int?
  /// Covered premium (100%, whole EGP) drawn from the pool; capped at the ceiling at commit time.
  premium         Int
  /// Per-covered-person snapshot at commit (spec 023) — age-band pricing, locked.
  coveredPeople   MedicalCoveredPerson[]
  /// Set when HR commits/edits on the employee's behalf; null for a self-commit.
  committedById   String?
  committedBy     User?                  @relation("MedicalCommitter", fields: [committedById], references: [id], onDelete: SetNull)
  committedAt     DateTime               @default(now())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([userId, planYearId])
}

/// Immutable snapshot of one covered person on a medical commitment (spec 023). Captured at commit
/// (age at the commit date; premium truncated to whole EGP), so the committed premium stays
/// explainable and immune to later DOB/dependant edits. dependantId null = the employee themselves.
model MedicalCoveredPerson {
  id           String            @id @default(cuid())
  commitmentId String
  commitment   MedicalCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  dependantId  String?
  dependant    Dependant?        @relation(fields: [dependantId], references: [id], onDelete: SetNull)
  label        String
  ageAtCommit  Int
  premiumEGP   Int

  @@index([commitmentId])
}

// ─── Dashboard (spec 006) ───────────────────────────────────────────────

/// A short company announcement shown on the dashboard (newest first).
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  authorId    String?
  publishedAt DateTime @default(now())

  @@index([publishedAt])
}

/// A reimbursement claim against a benefit (guaranteed or basket) for a plan year.
/// Multiple partial claims can be filed against one benefit, up to its allocation.
model BenefitClaim {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation("ClaimOwner", fields: [userId], references: [id], onDelete: Cascade)
  planYearId          String
  planYear            PlanYear            @relation(fields: [planYearId], references: [id], onDelete: Cascade)
  // Exactly one of these is set — the benefit being claimed.
  guaranteedBenefitId String?
  guaranteedBenefit   GuaranteedBenefit?  @relation(fields: [guaranteedBenefitId], references: [id], onDelete: Cascade)
  catalogItemId       String?
  catalogItem         BenefitCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  amount              Int
  note                String?
  proofUrl            String?
  proofName           String?
  status              ClaimStatus         @default(SUBMITTED)
  decisionNote        String? // HR rejection reason (optional)
  reviewedById        String? // HR approver/rejecter
  reviewedBy          User?               @relation("ClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())
  decidedAt           DateTime? // HR decision timestamp
  // Finance payment step (spec 020) — set when a claim is confirmed reimbursed.
  paidById            String?
  paidBy              User?               @relation("ClaimPayer", fields: [paidById], references: [id], onDelete: SetNull)
  paidAt              DateTime? // when Finance confirmed the transfer
  transferDate        DateTime? // actual date money was transferred (Finance-entered)
  amountTransferred   Int? // actual amount transferred (Finance-entered)

  @@index([userId, planYearId])
  @@index([status])
}

// ─── Incentive Scheme (super-user only; Team Benefits System v1.5) ──────────
// A hidden partner-compensation engine. Inputs are uploaded per cycle as four
// sheets (people / assignments / contributions / firm P&L); all money rules are
// computed server-side in src/lib/incentive. Distinct from the employee Benefits
// module. Sensitive salary/compensation data — SUPER_USER access only.

/// One compensation cycle (a half-year, e.g. "H1-2026") + firm-level P&L inputs.
model IncentiveCycle {
  id            String   @id @default(cuid())
  label         String   @unique // e.g. "H1-2026"
  status        String   @default("draft") // draft | final
  revenue       Float? // firm P&L: total revenue for the half
  deliveryCost  Float? // firm P&L: direct delivery cost
  totalExpenses Float? // firm P&L: total expenses
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  people        IncentivePerson[]
  assignments   IncentiveAssignment[]
  contributions IncentiveContribution[]
}

/// A person in a cycle (from people.csv). Salary is sensitive.
model IncentivePerson {
  id               String         @id @default(cuid())
  cycleId          String
  cycle            IncentiveCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  name             String
  role             String?
  netMonthlySalary Float
  startDate        DateTime?
  eligibleToLead   Boolean        @default(true) // stands in for the 50% utilisation gate
  utilization      Float? // overall/logged utilisation as a fraction 0..1

  @@unique([cycleId, name])
  @@index([cycleId])
}

/// An assignment in a cycle (from assignments.csv).
model IncentiveAssignment {
  id         String         @id @default(cuid())
  cycleId    String
  cycle      IncentiveCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  client     String
  type       String // PRJ | RET
  lead       String
  bd         String // business developer (commission earner)
  leadSource String? // bd === leadSource ⇒ self-generated (5%), else referred (3%)
  revenue    Float?
  directCost Float? // null when "Pending" (in-progress)
  vendorCost Float          @default(0)
  markupPct  Float          @default(0)
  startDate  DateTime?
  closeDate  DateTime?
  status     String // closed | ongoing | in_progress | pending (derived at import)

  @@unique([cycleId, client])
  @@index([cycleId])
}

/// One person's contribution share on one assignment (from the contributions matrix).
model IncentiveContribution {
  id      String         @id @default(cuid())
  cycleId String
  cycle   IncentiveCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  client  String
  person  String
  share   Float // fraction 0..1 as entered; validated to total ~1 per client

  @@unique([cycleId, client, person])
  @@index([cycleId])
}

/// Editable incentive-scheme rule constants (singleton, id = "singleton"). Mirrors
/// the built-in `INCENTIVE_RULES` defaults; the row only exists once a Super User
/// saves. `getIncentiveConfig()` falls back to the defaults when the row is absent,
/// so the engine is unchanged until a value is deliberately edited. Super-User edit only.
model IncentiveConfig {
  id                       String   @id @default("singleton")
  envelopeRate             Float
  marginGate               Float
  // Contributor tiers 1–3 (share threshold → deduction). Tier 4 (under t3, → 0) is implicit.
  tier1Min                 Float
  tier1Deduction           Float
  tier2Min                 Float
  tier2Deduction           Float
  tier3Min                 Float
  tier3Deduction           Float
  maxTotalDeduction        Float
  contributorCapMonths     Float
  contributorFloorMonths   Float
  commissionReferred       Float
  commissionSelfGenerated  Float
  retainerCommissionMonths Int
  cycleMonths              Int
  vendorMarkupMin          Float
  profitTargetMargin       Float
  profitFloorMargin        Float
  profitCeilingMonths      Float
  profitLeadFeeOffsetShare Float
  pricingFloorMultiple     Float
  updatedAt                DateTime @updatedAt
  updatedById              String?
}

// ─── Module release switch (super-user) ─────────────────────────────────────
/// On/off flag per platform module, so a super user can build in the background
/// and release modules when ready. Absent row = enabled (default on).
model ModuleFlag {
  key       String   @id // e.g. "benefits", "knowledge"
  enabled   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt
}

// ─── Branding (white-label per deployment, super-user) ──────────────────────
/// Single-row brand identity for this deployment: company name, logo, and the two
/// base colors (primary + accent) that re-theme the whole UI. Defaults to Forefront
/// navy/gold; when unchanged, no theme override is injected (identical look).
model BrandSettings {
  id           String   @id @default("singleton")
  companyName  String   @default("Forefront People") // official/legal name
  platformName String? // what shows in-app (wordmark); falls back to companyName
  shortName    String   @default("Forefront") // eyebrow / initial
  logoUrl      String?
  primaryColor String   @default("#0f2444") // navy-800
  accentColor  String   @default("#c9a227") // gold-500
  updatedAt    DateTime @default(now()) @updatedAt
}

// ─── Business Units (multi-brand, spec 024) ─────────────────────────────────
/// A group company an employee belongs to, carrying its own brand (name, logo,
/// primary + accent colors). The app theme follows the VIEWING user's business
/// unit; unset falls back to the BrandSettings default. Theming only — no data
/// isolation (that is spec 022's full multi-tenancy). Distinct from Department.
model BusinessUnit {
  id           String   @id @default(cuid())
  name         String   @unique // official company name; unique (case-insensitive enforced in app)
  platformName String? // what shows in-app (wordmark); falls back to name
  shortName    String // eyebrow / initial
  logoUrl      String? // private Blob URL; null = wordmark
  primaryColor String   @default("#0f2444") // navy-800
  accentColor  String   @default("#c9a227") // gold-500
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  members      User[]
}

// ─── Notification settings (super-user, spec 020) ───────────────────────────
/// Single-row config for the claim-workflow emails. Non-secret only: the master
/// on/off toggle, the HR and Finance team inboxes, and the outgoing from-name.
/// The Resend API key and sender address live in env (RESEND_API_KEY, EMAIL_FROM),
/// never here. With emails off or unconfigured the workflow still runs; nothing is sent.
model NotificationSettings {
  id           String   @id @default("singleton")
  emailEnabled Boolean  @default(false)
  hrInbox      String?
  financeInbox String?
  fromName     String?
  updatedAt    DateTime @default(now()) @updatedAt
}
