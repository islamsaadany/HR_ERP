// HR_ERP — Prisma schema
// Foundation module (spec 001): employee registry, roles, dependants, personal documents.
// Later modules add their own models. Real employee PII is seeded via prisma/sql/ files
// that are kept OUT of git (see .gitignore).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  EMPLOYEE
  HR_ADMIN
  SUPER_USER
  FINANCE // confirms benefit-claim payments (spec 020); SUPER_USER is a superset
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

// Four confirmed tenure bands (drive Benefits pool ceilings)
enum TenureBand {
  BAND_6MO_2Y // 6 months – 2 years
  BAND_2_4Y // 2 – 4 years
  BAND_4_7Y // 4 – 7 years
  BAND_7_10Y // 7 – 10 years
}

enum EmployeeStatus {
  ACTIVE
  LEFT
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

/// The employee registry — the backbone every module reads from.
model User {
  id       String  @id @default(cuid())
  email    String  @unique // login identity (Google, company domain)
  name     String
  photoUrl String?

  // Full official name as on the national ID (spec 029 extension, 2026-08-17) — English and
  // Arabic. Self-edited by the employee (like phone); HR can correct them on the admin form.
  // Private: shown on My Profile and the HR record only, never the Directory.
  legalName   String?
  legalNameAr String?
  // National ID number (same extension) — self-edited on My Profile (My Documents card),
  // HR-correctable, private. Free text: formats vary and a rejected real ID is worse.
  nationalId  String?

  // Public directory fields
  phone      String?
  department String?
  title      String?

  // Authorization
  role Role @default(EMPLOYEE)

  // Email + password sign-in (scrypt hash; null = password not set, Google-only).
  passwordHash       String?
  // Set true when HR issues a temporary password; the employee is gated to
  // /set-password on next sign-in until they choose their own compliant one.
  mustChangePassword Boolean @default(false)

  // Set when the employee first dismisses/finishes the Benefits orientation tour (spec 017);
  // stops it auto-opening again. The "How it works" button ignores this.
  benefitsOrientationSeenAt DateTime?

  // HR-private employment fields (money-affecting: HR-set, authoritative)
  employmentType EmploymentType?
  tenureBand     TenureBand?
  startDate      DateTime?
  endDate        DateTime?
  status         EmployeeStatus  @default(ACTIVE)
  monthlySalary  Int? // HR-private; used for the Loans benefit ceiling (up to one month)

  // HR-private personal fields
  dateOfBirth   DateTime?
  maritalStatus MaritalStatus?

  // Emergency contact (HR-managed; shown read-only on the employee's own Profile, never the Directory)
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  // Reporting line (org chart) — self relation
  reportsToId String?
  reportsTo   User?   @relation("Reports", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports     User[]  @relation("Reports")

  // Business unit (multi-brand, spec 024) — HR-managed; drives which brand this
  // user sees. Optional; null = the default brand. Distinct from `department`.
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)

  // Employee ID (spec 025) — HR-managed PERSON identifier. Optional and NOT unique:
  // a person holding two contracts is two accounts sharing one Employee ID, which
  // links them for the account switcher. Email stays the unique per-account login.
  employeeId String?

  // Per-user UI preferences (namespaced JSON) — e.g. the Employees grid column
  // layout {"employees.columns":[{key,visible},…]} so it follows the person across
  // browsers/devices. Cosmetic only; never affects data access or money rules.
  uiPrefs Json?

  dependants Dependant[]

  // Personal documents owned by this user
  documents         PersonalDocument[] @relation("DocOwner")
  uploadedDocuments PersonalDocument[] @relation("DocUploader")

  // Onboarding
  onboardingCompletions ActivityCompletion[]

  // Time-off
  leaveRequests  LeaveRequest[] @relation("LeaveRequester")
  leaveApprovals LeaveRequest[] @relation("LeaveApprover")

  // Benefits
  medicalCommitments       MedicalCommitment[]      @relation("MedicalOwner")
  committedMedical         MedicalCommitment[]      @relation("MedicalCommitter")
  benefitClaims            BenefitClaim[]           @relation("ClaimOwner")
  reviewedClaims           BenefitClaim[]           @relation("ClaimReviewer")
  paidClaims               BenefitClaim[]           @relation("ClaimPayer")
  sentHolidayAnnouncements HolidayAnnouncement[]    @relation("HolidayAnnouncer")
  benefitReleases          BenefitRelease[]         @relation("ReleaseSubject")
  releasesGiven            BenefitRelease[]         @relation("ReleaseActor")
  benefitGrants            GuaranteedBenefitGrant[] @relation("GrantSubject")
  benefitGrantsGiven       GuaranteedBenefitGrant[] @relation("GrantActor")
  medicalRecoveries        MedicalRecovery[]        @relation("RecoverySubject")
  recoveriesSettled        MedicalRecovery[]        @relation("RecoverySettler")

  // Profile change requests (spec 029)
  profileChangeRequests ProfileChangeRequest[] @relation("ChangeRequester")
  profileFieldDecisions ProfileChangeField[]   @relation("FieldDecider")

  // Plan-year cap switch (spec 031)
  flexCapChanges PlanYear[] @relation("FlexCapChanger")

  // Profile data request campaigns (spec 033)
  campaignsCreated DataRequestCampaign[] @relation("CampaignCreator")
  campaignTargets  DataRequestTarget[]   @relation("CampaignTarget")

  // Learning Track (spec 038) — back-relations only; this feature adds NO column to User.
  coursesCreated            Course[]             @relation("CourseCreator")
  coursesUpdated            Course[]             @relation("CourseUpdater")
  courseAudiencesCreated    CourseAudience[]     @relation("AudienceCreator")
  learnerGroupsCreated      LearnerGroup[]       @relation("LearnerGroupCreator")
  learnerGroupMemberships   LearnerGroupMember[] @relation("GroupMemberSubject")
  learnerGroupMembersAdded  LearnerGroupMember[] @relation("GroupMemberAdder")
  courseAssignments         CourseAssignment[]   @relation("CourseAssignmentSubject")
  courseAssignmentsGranted  CourseAssignment[]   @relation("CourseAssignmentActor")
  courseEnrollments         CourseEnrollment[]   @relation("EnrollmentLearner")
  courseAccessWithdrawn     CourseEnrollment[]   @relation("AccessWithdrawer")
  // Course materials (spec 038 materials, 2026-08-22)
  courseDocumentsUploaded   CourseDocument[]     @relation("CourseDocumentUploader")
  courseResourcesSuggested  CourseResource[]     @relation("CourseResourceSuggester")
  courseResourcesReviewed   CourseResource[]     @relation("CourseResourceReviewer")
  courseRatings             CourseRating[]       @relation("CourseRater")
  learningManager           LearningManager?     @relation("LearningManagerSubject")
  learningManagersAppointed LearningManager[]    @relation("LearningManagerAppointer")

  // Team Communications (spec 039) — back-relations only; this feature adds NO column to User.
  messagesAbout    Message[]          @relation("MessageSubject")
  messagesAssigned Message[]          @relation("MessageAssignee")
  messagesCreated  Message[]          @relation("MessageAuthor")
  messagesSent     Message[]          @relation("MessageSender")
  messagesReceived MessageRecipient[] @relation("MessageAddressee")

  // Performance reviews & 1:1s (spec 042) — back-relations only; this feature adds NO column to User.
  reviewSheetsAsEmployee ReviewSheet[]      @relation("ReviewSheetEmployee")
  reviewSheetsAsManager  ReviewSheet[]      @relation("ReviewSheetManager")
  reviewSheetItems       ReviewSheetItem[]  @relation("ReviewItemAuthor")
  reviewOutcomesAuthored ReviewOutcome[]    @relation("ReviewOutcomeAuthor")
  journalEntries         JournalEntry[]     @relation("JournalAuthor")
  oneOnOnesAsEmployee    OneOnOne[]         @relation("OneOnOneEmployee")
  oneOnOnesAsManager     OneOnOne[]         @relation("OneOnOneManager")
  oneOnOnesCreated       OneOnOne[]         @relation("OneOnOneCreator")
  oneOnOneNotes          OneOnOneNote[]     @relation("OneOnOneNoteAuthor")
  strengthsProfile       StrengthsProfile?  @relation("StrengthsProfileSubject")
  strengthsConfirmed     StrengthsProfile[] @relation("StrengthsProfileConfirmer")
  occasions              Occasion[]         @relation("OccasionSubject")

  // Finance: petty cash & payback (spec 040) — back-relations only; this feature adds NO
  // column to User. Custody is an attribute of the ACCOUNT, not of the person.
  pettyCashAccounts         PettyCashAccount[]      @relation("PettyCashCustodian")
  pettyCashAccountsCreated  PettyCashAccount[]      @relation("PettyCashAccountCreator")
  pettyCashPeriodsSubmitted PettyCashPeriod[]       @relation("PettyCashPeriodSubmitter")
  pettyCashPeriodsClosed    PettyCashPeriod[]       @relation("PettyCashPeriodCloser")
  pettyCashPeriodsReopened  PettyCashPeriod[]       @relation("PettyCashPeriodReopener")
  pettyCashMissingAcks      PettyCashPeriod[]       @relation("PettyCashMissingEvidenceAck")
  pettyCashFundingsRecorded PettyCashFunding[]      @relation("PettyCashFundingRecorder")
  pettyCashLinesCreated     PettyCashLine[]         @relation("PettyCashLineCreator")
  pettyCashLinesDeleted     PettyCashLineDeletion[] @relation("PettyCashLineDeleter")
  paybackRequests           PaybackRequest[]        @relation("PaybackRequester")
  paybackRequestsDecided    PaybackRequest[]        @relation("PaybackDecider")
  paybackRequestsPaid       PaybackRequest[]        @relation("PaybackPayer")
  expenseEvidenceUploaded   ExpenseEvidence[]       @relation("ExpenseEvidenceUploader")

  // Bank confirmations (spec 041) — back-relations only; no column is added to User. Who may
  // confirm is a row in TransactionConfirmer, never an attribute of the person.
  transactionConfirmers   TransactionConfirmer[] @relation("TransactionConfirmerSubject")
  confirmersAppointed     TransactionConfirmer[] @relation("TransactionConfirmerAppointer")
  paymentBatchesSubmitted PaymentBatch[]         @relation("PaymentBatchSubmitter")
  paymentBatchesDecided   PaymentBatch[]         @relation("PaymentBatchDecider")

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  poolExceptions        PoolCeilingException[] @relation("PoolExceptionSubject")
  poolExceptionsGranted PoolCeilingException[] @relation("PoolExceptionActor")

  @@index([department])
  @@index([status])
  @@index([reportsToId])
  @@index([businessUnitId])
  @@index([employeeId])
}

// ─── Profile data request campaigns (spec 033) ─────────────────────────
// HR/Finance ask targeted employees to fill or verify specific registry fields via a popup.
// Answers write DIRECTLY to the User record (the aligned decision — HR asked for the data);
// these tables only record who was asked, for what, and what happened, for the tracker.

enum DataRequestFieldStatus {
  PENDING // not answered yet
  FILLED // was empty, employee provided a value
  CONFIRMED // was prefilled, employee confirmed it unchanged
  CORRECTED // was prefilled, employee replaced it
}

model DataRequestCampaign {
  id          String    @id @default(cuid())
  title       String // shown to employees in the popup
  /// Requested field keys from the campaign field registry, in registry order.
  fields      String[]
  /// Human-readable audience descriptor frozen at launch (e.g. "All active employees").
  audience    String
  createdById String?
  createdBy   User?     @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  /// Set when HR/Finance closes it: popups/badges vanish, tracker stays readable (FR-010).
  closedAt    DateTime?

  targets DataRequestTarget[]

  @@index([closedAt])
}

/// One targeted employee in one campaign — resolved at launch (FR-002), never auto-grown.
model DataRequestTarget {
  id         String              @id @default(cuid())
  campaignId String
  campaign   DataRequestCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User                @relation("CampaignTarget", fields: [userId], references: [id], onDelete: Cascade)

  fields DataRequestFieldState[]

  @@unique([campaignId, userId])
  @@index([userId])
}

/// Per-field outcome for one target. `value` is the display snapshot the tracker shows;
/// the live User record stays the single source of truth for registry/CSV.
model DataRequestFieldState {
  id         String                 @id @default(cuid())
  targetId   String
  target     DataRequestTarget      @relation(fields: [targetId], references: [id], onDelete: Cascade)
  field      String
  status     DataRequestFieldStatus @default(PENDING)
  value      String?
  answeredAt DateTime?

  @@unique([targetId, field])
}

/// A dependant of an employee — name + DOB, and a kind (CHILD or SPOUSE). Age is derived, never stored.
/// The spouse is a dependant (kind = SPOUSE) so medical can price it by age like a child (spec 023).
model Dependant {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  dateOfBirth DateTime
  kind        DependantKind @default(CHILD)
  createdAt   DateTime      @default(now())

  medicalCoverage MedicalCoveredPerson[]

  @@index([userId])
}

/// Distinguishes a covered spouse from a child on a Dependant (spec 023). At most one SPOUSE per user.
enum DependantKind {
  CHILD
  SPOUSE
}

/// A personal document owned by one employee (ID, certificate, contract, HR letter).
/// Visible to the owner and HR/Super User only. Company-wide files live in Handbook & Resources.
model PersonalDocument {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation("DocOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  blobUrl      String
  contentType  String?
  sizeBytes    Int?
  uploadedById String?
  uploadedBy   User?    @relation("DocUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([ownerId])
}

// ─── Onboarding (spec 002) ──────────────────────────────────────────────

enum ActivityType {
  POLICY // read & acknowledge
  ACTION // do & complete
}

enum OnboardingTrackKey {
  COMMON_CORE // everyone
  CONSULTING // Consulting role track
}

/// An onboarding activity — the unit a joiner acknowledges (Policy) or completes (Action).
model OnboardingActivity {
  id          String               @id @default(cuid())
  title       String
  description String?
  type        ActivityType
  stage       String // free-text group label, e.g. "Week 1", "Check-ins"
  track       OnboardingTrackKey   @default(COMMON_CORE)
  linkUrl     String? // deep link into another module or a resource
  order       Int                  @default(0)
  active      Boolean              @default(true)
  completions ActivityCompletion[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([track, stage, order])
}

/// A joiner's self-attested acknowledgement/completion of an activity.
model ActivityCompletion {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId  String
  activity    OnboardingActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  completedAt DateTime           @default(now())

  @@unique([userId, activityId])
  @@index([userId])
}

// ─── Knowledge Base (spec 008) ──────────────────────────────────────────

/// A knowledge-base article ("read") authored in Markdown. Grouped by a
/// free-text category; body supports GFM + [!CALLOUT] blocks + mermaid.
model KnowledgeArticle {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  cluster        String? // top-level grouping (e.g. "Consulting"); category = topic within it
  category       String
  summary        String?
  body           String   @default("") // markdown (front-matter stripped)
  readingMinutes Int?
  attachmentUrl  String? // optional deck (PDF) shown/embedded under the article body
  attachmentName String? // original filename, used as the download label
  attachmentType String? // MIME type (v1: application/pdf)
  attachmentSize Int? // bytes
  published      Boolean  @default(true)
  order          Int      @default(0)
  authorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([published])
}

// ─── Handbook & Resources (spec 004) ────────────────────────────────────

/// A browsable, searchable handbook section (native content).
model HandbookSection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String?
  body        String   @default("") // markdown/plain text
  actionLabel String? // optional CTA button (e.g. "Request time off")
  actionHref  String? // …linking to the matching tool/module
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

/// A downloadable company file (company profile, template, policy, …).
model Resource {
  id           String   @id @default(cuid())
  title        String
  category     String   @default("Other")
  blobUrl      String
  contentType  String?
  sizeBytes    Int?
  uploadedById String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([category])
}

// ─── Time-Off / Leave (spec 005) ────────────────────────────────────────

enum LeaveStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

/// A time-off request (full days). Approved by the requester's direct manager
/// (or a Super User when none exists). No balances/types in v1.
model LeaveRequest {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  note            String?
  status          LeaveStatus @default(PENDING)
  approverId      String?
  approver        User?       @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decisionComment String?
  decidedAt       DateTime?
  // Null once a decision (approve/decline) is made and not yet seen by the requester;
  // set when the requester views their Time-Off page. Drives the nav badge (FR-014).
  decisionSeenAt  DateTime?
  /// Set when the request is cancelled (spec 035). A cancelled row WITH a decidedAt was an
  /// approved trip the employee called off before it started — shown as such to manager/HR.
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([approverId, status])
}

/// Where a holiday entry came from. A fetched suggestion is only a prediction until HR
/// verifies it; one HR typed by hand is deliberate, so it starts verified.
enum HolidaySource {
  FETCHED
  MANUAL
}

/// A holiday's date confidence (spec 037). TENTATIVE entries are what the daily cron asks
/// HR to check; VERIFIED and MOVED are both date-confirmed and may be announced.
enum HolidayStatus {
  TENTATIVE
  VERIFIED
  MOVED
}

/// An HR-managed public holiday (spec 035, evolved by spec 037). Every day of the ACTUAL
/// range counts as a non-working day everywhere time off is counted — alongside the fixed
/// Friday+Saturday weekend.
///
/// Two ranges, because the government moves holidays: `original*` is what was announced and
/// never changes after creation, `actual*` is where the holiday really lands and is what all
/// counting reads. A range (not a single date) so a multi-day holiday like Eid is ONE entry
/// that HR verifies and moves as a whole. All dates are UTC midnight; single-day holidays
/// have start == end. Actual ranges never overlap — enforced in the admin server actions,
/// which are the only write path (Prisma cannot express an exclusion constraint).
model PublicHoliday {
  id             String        @id @default(cuid())
  name           String
  /// Arabic name from the fetch source, used by the bilingual announcement. Null when HR
  /// typed the entry by hand and gave only the English name.
  localName      String?
  originalStart  DateTime
  originalEnd    DateTime
  actualStart    DateTime
  actualEnd      DateTime
  status         HolidayStatus @default(TENTATIVE)
  source         HolidaySource @default(MANUAL)
  /// Set when HR confirms the date or moves it — either way the date is settled.
  verifiedAt     DateTime?
  /// Stamped when the cron has asked HR to verify this occurrence, so the reminder is sent
  /// once per holiday rather than every day of its window.
  reminderSentAt DateTime?
  /// HR's work-in-progress announcement text, saved without sending. Null until they save;
  /// once set it is what the composer opens with, instead of the freshly generated draft.
  draftSubject   String?
  draftBodyEn    String?
  draftBodyAr    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  announcements HolidayAnnouncement[]

  @@index([actualStart])
}

/// Whether this send was the holiday's first announcement or a correction issued after its
/// dates changed (spec 037 FR-018).
enum AnnouncementKind {
  ORIGINAL
  CORRECTION
}

/// One announcement actually sent to the team about one holiday (spec 037).
///
/// Stores the text AS SENT — HR edits the draft, so the draft is not the record. The
/// `announced*` range is a snapshot of the holiday's actual dates at send time: when the
/// holiday later moves, comparing the two is what flags "announced with an outdated date"
/// without needing a status column to keep in step.
model HolidayAnnouncement {
  id             String           @id @default(cuid())
  holidayId      String
  holiday        PublicHoliday    @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  kind           AnnouncementKind @default(ORIGINAL)
  subject        String
  bodyEn         String
  bodyAr         String
  announcedStart DateTime
  announcedEnd   DateTime
  /// Comma-joined yyyy-mm-dd bridge days called out in this message — powers the banner's
  /// callout and the prefilled request link.
  bridgeDates    String?
  sentById       String?
  sentBy         User?            @relation("HolidayAnnouncer", fields: [sentById], references: [id], onDelete: SetNull)
  sentAt         DateTime         @default(now())
  /// How many active employees the send addressed — the audit of reach at that moment.
  recipientCount Int              @default(0)

  @@index([holidayId])
}

// ─── Benefits (spec 007) ────────────────────────────────────────────────

enum PlanYearStatus {
  OPEN
  CLOSED
}

/// What an employee must provide to claim/reimburse a benefit.
enum ClaimType {
  NONE // paid automatically — no request needed
  NOTE // request with an optional note/description
  PROOF // mandatory proof-of-payment upload, reviewed before release
}

// Spec 020 staged workflow: Submitted (awaiting HR) → Approved (awaiting Finance
// payment) → Reimbursed (paid); Rejected is terminal from Submitted. (The legacy
// spec-018 PENDING/RELEASED values were retired by migration 031.)
enum ClaimStatus {
  SUBMITTED
  APPROVED
  /// Finance has created the transaction in the bank and submitted it for confirmation (spec 040).
  /// A claim reaches REIMBURSED — and the employee is told — only when the CEO confirms it at the
  /// bank and marks it complete. Before that nobody has actually been paid, and telling them so
  /// was the confusion this state removes.
  PAYMENT_SUBMITTED
  REIMBURSED
  REJECTED
}

/// A benefits cycle. Employees can save/submit only while OPEN.
model PlanYear {
  id                 String                   @id @default(cuid())
  name               String
  status             PlanYearStatus           @default(OPEN)
  /// Proration window (spec 019). Admin-set; nullable for legacy rows / fallback.
  /// When either is null the year is treated as having no window → no proration.
  startDate          DateTime?
  endDate            DateTime?
  /// The 50%-per-benefit cap, per cycle (spec 031). ON is the rule; OFF is a deliberate HR
  /// exception for a cycle prorated so short that half a small ceiling is a trivial amount.
  ///
  /// It lives on the CYCLE, not in global config: a global flag would mean flipping it today
  /// changes the rules a closed cycle's claims were judged under, and what was allowed when
  /// would no longer be recoverable. Changing it is never retroactive — no existing claim is
  /// re-evaluated, reduced or reversed.
  flexCapEnabled     Boolean                  @default(true)
  flexCapChangedById String?
  flexCapChangedBy   User?                    @relation("FlexCapChanger", fields: [flexCapChangedById], references: [id], onDelete: SetNull)
  flexCapChangedAt   DateTime?
  createdAt          DateTime                 @default(now())
  medicalCommitments MedicalCommitment[]
  medicalCharges     MedicalCycleCharge[]
  claims             BenefitClaim[]
  releases           BenefitRelease[]
  benefitGrants      GuaranteedBenefitGrant[]
  poolExceptions     PoolCeilingException[]
}

/// Pool ceiling per (employment type × tenure band). Max claimable for the year.
model PoolCeiling {
  id             String         @id @default(cuid())
  employmentType EmploymentType
  tenureBand     TenureBand
  amount         Int

  @@unique([employmentType, tenureBand])
}

/// A fixed/guaranteed benefit. One row per benefit (spec 021): eligibility is a pair of
/// flags (Full-time / Part-time) shown in the unified Benefits Catalogue, and amounts are
/// held per employment type × tenure band (ft* / pt* columns) on the numbers-only Amounts tab.
/// Superseded the old "one row per (benefit × employmentType)" model.
model GuaranteedBenefit {
  id               String                   @id @default(cuid())
  name             String
  note             String?
  /// Grouping category shown in the unified catalogue (spec 021), aligned with the flexible
  /// benefit categories (e.g. "Life & family", "Personal growth"). Distinct from `note` (a short
  /// description). Null falls back to "Other".
  category         String?
  /// Who this benefit is available to. Drives what each employee sees by their employment type.
  eligibleFullTime Boolean                  @default(true)
  eligiblePartTime Boolean                  @default(true)
  /// Full-time amounts per tenure band (null = salary-driven / not set).
  ftBand6mo2y      Int?
  ftBand2to4y      Int?
  ftBand4to7y      Int?
  ftBand7to10y     Int?
  /// Part-time amounts per tenure band (null = salary-driven / not set).
  ptBand6mo2y      Int?
  ptBand2to4y      Int?
  ptBand4to7y      Int?
  ptBand7to10y     Int?
  order            Int                      @default(0)
  claimType        ClaimType                @default(NOTE)
  /// Whether this guaranteed benefit's annual budget is prorated for mid-year
  /// starters (spec 019). True only for Professional development; event/season
  /// gifts (marriage, summer, special events, loans) stay false = full-when-triggered.
  prorated         Boolean                  @default(false)
  claims           BenefitClaim[]
  releases         BenefitRelease[]
  grants           GuaranteedBenefitGrant[]
}

/// A per-person eligibility exception (spec 036): ONE employee granted ONE guaranteed benefit
/// for ONE plan year, at an explicit Super-User-typed amount. The granted person goes through
/// the completely normal request → approve → pay flow; a grant never widens the benefit's
/// general eligibility and expires with the cycle.
model GuaranteedBenefitGrant {
  id                  String            @id @default(cuid())
  guaranteedBenefitId String
  guaranteedBenefit   GuaranteedBenefit @relation(fields: [guaranteedBenefitId], references: [id], onDelete: Cascade)
  userId              String
  user                User              @relation("GrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  planYearId          String
  planYear            PlanYear          @relation(fields: [planYearId], references: [id], onDelete: Cascade)
  amount              Int
  grantedById         String?
  grantedBy           User?             @relation("GrantActor", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt           DateTime          @default(now())

  @@unique([userId, guaranteedBenefitId, planYearId])
  @@index([planYearId])
}

/**
 * A per-employee record that a fixed-allowance guaranteed benefit was released for a plan year
 * (spec 013). Presence of a row = "Released"; absence = "Not released". `amount` snapshots the
 * band-derived figure at release time. Salary-driven benefits (Loans) are never released here.
 */
model BenefitRelease {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation("ReleaseSubject", fields: [userId], references: [id], onDelete: Cascade)
  guaranteedBenefitId String
  guaranteedBenefit   GuaranteedBenefit @relation(fields: [guaranteedBenefitId], references: [id], onDelete: Cascade)
  planYearId          String
  planYear            PlanYear          @relation(fields: [planYearId], references: [id], onDelete: Cascade)
  amount              Int
  releasedAt          DateTime          @default(now())
  releasedById        String?
  releasedBy          User?             @relation("ReleaseActor", fields: [releasedById], references: [id], onDelete: SetNull)

  @@unique([userId, guaranteedBenefitId, planYearId])
  @@index([guaranteedBenefitId, planYearId])
}

/// Managed list of valid department names (HR-editable, spec 014). The employee's
/// `department` stays a text label on User; this table is the source of choices/filters.
/// Renaming a department cascades to matching User.department values; a department can
/// only be removed while no employee is assigned to it. Not a foreign key.
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

/// Age-banded medical rate card (spec 023). One row per age band; premium is looked up by a covered
/// person's age. `tier` allows more tiers later — only Tier 1 exists today. Amounts carry two decimals
/// (the operator quotes cents); employee-facing figures drop the cents (truncate).
model MedicalRateBand {
  id            String  @id @default(cuid())
  tier          Int     @default(1)
  minAge        Int
  maxAge        Int?
  annualPremium Decimal @db.Decimal(10, 2)
  order         Int     @default(0)

  @@unique([tier, minAge])
  @@index([tier])
}

/// Medical cover scope (spec 021). Personal = the employee only; Family = employee + spouse + children.
enum MedicalScope {
  PERSONAL
  FAMILY
}

/// A selectable flexible-basket category. Medical is special (rate-card priced, cap-exempt).
model BenefitCatalogItem {
  id               String         @id @default(cuid())
  key              String         @unique
  name             String
  description      String?
  category         String?
  isMedical        Boolean        @default(false)
  /// For medical items only (spec 021): PERSONAL (self) or FAMILY (self + dependants). Null for non-medical.
  medicalScope     MedicalScope?
  /// Who this benefit is available to. Drives what each employee sees by their employment type.
  eligibleFullTime Boolean        @default(true)
  eligiblePartTime Boolean        @default(true)
  order            Int            @default(0)
  active           Boolean        @default(true)
  claimType        ClaimType      @default(PROOF)
  /// Company coverage rate, percent 0–100 (spec 012). The covered (company) share = cost × rate/100
  /// draws from the pool; the employee pays the remainder. Medical is 100% (cost = covered).
  coverageRate     Int            @default(100)
  /// Fixed per-tenure-band allowance (spec 028 — travel allowance). When any of these is set the
  /// benefit is an ENTITLEMENT rather than a receipt-based claim: the employee requests it and is
  /// paid the band amount in full, with no price entered and no proof. It still draws from the
  /// pool and still prorates with the cycle. One amount per band for full- AND part-timers — the
  /// pool ceiling already differs by employment type, so a second set of figures would only be a
  /// chance for the two to drift apart. Null on every ordinary coverage-rate benefit.
  band6mo2y        Int?
  band2to4y        Int?
  band4to7y        Int?
  band7to10y       Int?
  claims           BenefitClaim[]
}

/// An employee's committed medical election for a plan year (spec 018) — the single commitment in
/// the flexible-benefits module. Existence of the row means medical is committed. The employee
/// cannot edit or remove it after committing; only HR (admin) may, as an exception. Flexible
/// benefits have no selection/allocation record — they are claimed directly (see BenefitClaim).
model MedicalCommitment {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation("MedicalOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// The benefits cycle the commitment was MADE IN. Retained for history; no longer the key —
  /// a commitment belongs to the policy term it buys, which can outlive this cycle (spec 027).
  planYearId      String
  planYear        PlanYear               @relation(fields: [planYearId], references: [id], onDelete: Cascade)
  /// The insurance term this commitment buys (spec 027). Nullable only so the migration can
  /// backfill; every new commitment sets it.
  policyYearId    String?
  policyYear      MedicalPolicyYear?     @relation(fields: [policyYearId], references: [id], onDelete: Cascade)
  /// How the premium is spread across the benefits cycles the term overlaps (spec 027).
  cycleCharges    MedicalCycleCharge[]
  /// Unused premium to reclaim if the employee leaves mid-term (spec 030).
  recovery        MedicalRecovery?
  /// LEGACY (spec 023): the old relationship-based selection. Nullable, no longer written for new
  /// commits — retained so historical rows keep their record. Superseded by `coveredPeople`.
  spouse          Boolean?
  childrenUnder18 Int?
  children18Plus  Int?
  /// The FULL covered premium (100%, whole EGP) for the whole policy term. Since spec 027 this
  /// is no longer what a single pool absorbs — see `cycleCharges` for the per-cycle amounts.
  premium         Int
  /// Per-covered-person snapshot at commit (spec 023) — age-band pricing, locked.
  coveredPeople   MedicalCoveredPerson[]
  /// Set when HR commits/edits on the employee's behalf; null for a self-commit.
  committedById   String?
  committedBy     User?                  @relation("MedicalCommitter", fields: [committedById], references: [id], onDelete: SetNull)
  committedAt     DateTime               @default(now())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  /// Commit once per POLICY TERM (spec 027), not per benefits cycle — keying it to the cycle is
  /// what made a mid-cycle insurance renewal invisible to the system.
  @@unique([userId, policyYearId])
}

/// The medical insurance contract's own term (spec 027) — 1 Jun → 31 May today. Runs on the
/// insurer's schedule, independently of the benefits plan year (Jan–Dec), so a term always
/// straddles two cycles. Its length is whatever HR sets: nothing may assume twelve months.
model MedicalPolicyYear {
  id          String               @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  status      PlanYearStatus       @default(OPEN)
  createdAt   DateTime             @default(now())
  commitments MedicalCommitment[]
  charges     MedicalCycleCharge[]
  recoveries  MedicalRecovery[]
}

/// The share of one commitment's premium attributed to one benefits cycle (spec 027). THIS is
/// what draws against that cycle's pool — not the full premium. The shares of a commitment sum
/// to its premium exactly once the covering cycles exist.
model MedicalCycleCharge {
  id            String              @id @default(cuid())
  commitmentId  String
  commitment    MedicalCommitment   @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  planYearId    String
  planYear      PlanYear            @relation(fields: [planYearId], references: [id], onDelete: Cascade)
  policyYearId  String
  policyYear    MedicalPolicyYear   @relation(fields: [policyYearId], references: [id], onDelete: Cascade)
  /// Whole EGP, already capped at that cycle's pool ceiling.
  amount        Int
  /// Whole months of the term inside this cycle — stored so the charge stays explainable years
  /// later without recomputing it against a policy window that may since have changed.
  overlapMonths Int
  status        MedicalChargeStatus @default(SCHEDULED)
  /// Set when the status becomes APPLIED.
  appliedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([commitmentId, planYearId])
}

/// SCHEDULED — calculated, not yet drawing against a pool (a future cycle).
/// APPLIED    — drawing against that cycle's pool now.
/// CANCELLED  — cover ended before the cycle began. NOT a liability: premium paid in advance for
///              cover after the leave date is recovered from the insurer, so nothing is owed.
enum MedicalChargeStatus {
  SCHEDULED
  APPLIED
  CANCELLED
}

/// OPEN — owed by the insurer and not yet chased to a conclusion.
/// RECOVERED — a credit was received; `recoveredAmount` is what actually came back.
/// WRITTEN_OFF — Finance decided it isn't coming; `reason` says why. The whole expected amount
///               becomes the shortfall, so a written-off recovery is a recorded loss, not a gap.
enum MedicalRecoveryStatus {
  OPEN
  RECOVERED
  WRITTEN_OFF
}

/// Premium the company paid for medical cover an employee never used, because they left before
/// the policy term ended (spec 030). Finance's to-do: chase the insurer, then record what came
/// back. The residual is a real cost of the departure — the point is that it becomes a known
/// number rather than an invisible one.
model MedicalRecovery {
  id                String                @id @default(cuid())
  /// One recovery per commitment — the unique key is what makes the reconcile pass idempotent.
  commitmentId      String                @unique
  commitment        MedicalCommitment     @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  userId            String
  user              User                  @relation("RecoverySubject", fields: [userId], references: [id], onDelete: Cascade)
  policyYearId      String
  policyYear        MedicalPolicyYear     @relation(fields: [policyYearId], references: [id], onDelete: Cascade)
  /// The employee's last day of cover. Null when HR hasn't recorded one — the row then reads
  /// "needs leave date" rather than showing a confidently wrong figure.
  coverEndedOn      DateTime?
  /// The premium this expectation was computed from, FROZEN at creation. A later premium edit must
  /// not restate a figure Finance may already have claimed against.
  premiumAtCreation Int
  expectedMonths    Int
  expectedAmount    Int
  status            MedicalRecoveryStatus @default(OPEN)
  /// What actually came back. Null until settled; 0 on a write-off.
  recoveredAmount   Int?
  recoveredOn       DateTime?
  /// expected − recovered, never below zero. The number that makes a short-paying insurer visible.
  shortfall         Int?
  /// Why it was written off.
  reason            String?
  settledById       String?
  settledBy         User?                 @relation("RecoverySettler", fields: [settledById], references: [id], onDelete: SetNull)
  settledAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status])
}

/// Immutable snapshot of one covered person on a medical commitment (spec 023). Captured at commit
/// (age at the commit date; premium truncated to whole EGP), so the committed premium stays
/// explainable and immune to later DOB/dependant edits. dependantId null = the employee themselves.
model MedicalCoveredPerson {
  id           String            @id @default(cuid())
  commitmentId String
  commitment   MedicalCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  dependantId  String?
  dependant    Dependant?        @relation(fields: [dependantId], references: [id], onDelete: SetNull)
  label        String
  ageAtCommit  Int
  premiumEGP   Int

  @@index([commitmentId])
}

// ─── Dashboard (spec 006) ───────────────────────────────────────────────

/// A short company announcement shown on the dashboard (newest first).
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  authorId    String?
  publishedAt DateTime @default(now())

  @@index([publishedAt])
}

/// A reimbursement claim against a benefit (guaranteed or basket) for a plan year.
/// Multiple partial claims can be filed against one benefit, up to its allocation.
model BenefitClaim {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation("ClaimOwner", fields: [userId], references: [id], onDelete: Cascade)
  planYearId          String
  planYear            PlanYear            @relation(fields: [planYearId], references: [id], onDelete: Cascade)
  // Exactly one of these is set — the benefit being claimed.
  guaranteedBenefitId String?
  guaranteedBenefit   GuaranteedBenefit?  @relation(fields: [guaranteedBenefitId], references: [id], onDelete: Cascade)
  catalogItemId       String?
  catalogItem         BenefitCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  /// The COVERED (company) amount — what will actually be reimbursed. May be less than
  /// `fullCost × coverageRate` when the 50%-per-benefit cap or the pool ceiling clamps it.
  amount              Int
  /// The full price on the employee's receipt, as they entered it. Nullable: claims created
  /// before this column existed have no receipt value recorded, and guaranteed benefits
  /// (which have no coverage rate) don't set it. Stored so HR can reconcile a clamped claim
  /// against its proof — "receipt 10,000 · covered 8,000 · capped to 7,000".
  fullCost            Int?
  note                String?
  proofUrl            String?
  proofName           String?
  status              ClaimStatus         @default(SUBMITTED)
  decisionNote        String? // HR rejection reason (optional)
  reviewedById        String? // HR approver/rejecter
  reviewedBy          User?               @relation("ClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())
  decidedAt           DateTime? // HR decision timestamp
  // Finance payment step (spec 020) — set when a claim is confirmed reimbursed.
  paidById            String?
  paidBy              User?               @relation("ClaimPayer", fields: [paidById], references: [id], onDelete: SetNull)
  paidAt              DateTime? // when Finance confirmed the transfer
  transferDate        DateTime? // actual date money was transferred (Finance-entered)
  amountTransferred   Int? // actual amount transferred (Finance-entered)

  /// Submissions this claim's reimbursement was included in (spec 040).
  batchItems PaymentBatchItem[]

  @@index([userId, planYearId])
  @@index([status])
}

// ─── Incentive Scheme (super-user only; Team Benefits System v1.5) ──────────
// A hidden partner-compensation engine. Inputs are uploaded per cycle as four
// sheets (people / assignments / contributions / firm P&L); all money rules are
// computed server-side in src/lib/incentive. Distinct from the employee Benefits
// module. Sensitive salary/compensation data — SUPER_USER access only.

/// One compensation cycle (a half-year, e.g. "H1-2026") + firm-level P&L inputs.
model IncentiveCycle {
  id            String   @id @default(cuid())
  label         String   @unique // e.g. "H1-2026"
  status        String   @default("draft") // draft | final
  revenue       Float? // firm P&L: total revenue for the half
  deliveryCost  Float? // firm P&L: direct delivery cost
  totalExpenses Float? // firm P&L: total expenses
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  people        IncentivePerson[]
  assignments   IncentiveAssignment[]
  contributions IncentiveContribution[]
}

/// A person in a cycle (from people.csv). Salary is sensitive.
model IncentivePerson {
  id               String         @id @default(cuid())
  cycleId          String
  cycle            IncentiveCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  name             String
  role             String?
  netMonthlySalary Float
  startDate        DateTime?
  eligibleToLead   Boolean        @default(true) // stands in for the 50% utilisation gate
  utilization      Float? // overall/logged utilisation as a fraction 0..1

  @@unique([cycleId, name])
  @@index([cycleId])
}

/// An assignment in a cycle (from assignments.csv).
model IncentiveAssignment {
  id         String         @id @default(cuid())
  cycleId    String
  cycle      IncentiveCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  client     String
  type       String // PRJ | RET
  lead       String
  bd         String // business developer (commission earner)
  leadSource String? // bd === leadSource ⇒ self-generated (5%), else referred (3%)
  revenue    Float?
  directCost Float? // null when "Pending" (in-progress)
  vendorCost Float          @default(0)
  markupPct  Float          @default(0)
  startDate  DateTime?
  closeDate  DateTime?
  status     String // closed | ongoing | in_progress | pending (derived at import)

  @@unique([cycleId, client])
  @@index([cycleId])
}

/// One person's contribution share on one assignment (from the contributions matrix).
model IncentiveContribution {
  id      String         @id @default(cuid())
  cycleId String
  cycle   IncentiveCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  client  String
  person  String
  share   Float // fraction 0..1 as entered; validated to total ~1 per client

  @@unique([cycleId, client, person])
  @@index([cycleId])
}

/// Editable incentive-scheme rule constants (singleton, id = "singleton"). Mirrors
/// the built-in `INCENTIVE_RULES` defaults; the row only exists once a Super User
/// saves. `getIncentiveConfig()` falls back to the defaults when the row is absent,
/// so the engine is unchanged until a value is deliberately edited. Super-User edit only.
model IncentiveConfig {
  id                       String   @id @default("singleton")
  envelopeRate             Float
  marginGate               Float
  // Contributor tiers 1–3 (share threshold → deduction). Tier 4 (under t3, → 0) is implicit.
  tier1Min                 Float
  tier1Deduction           Float
  tier2Min                 Float
  tier2Deduction           Float
  tier3Min                 Float
  tier3Deduction           Float
  maxTotalDeduction        Float
  contributorCapMonths     Float
  contributorFloorMonths   Float
  commissionReferred       Float
  commissionSelfGenerated  Float
  retainerCommissionMonths Int
  cycleMonths              Int
  vendorMarkupMin          Float
  profitTargetMargin       Float
  profitFloorMargin        Float
  profitCeilingMonths      Float
  profitLeadFeeOffsetShare Float
  pricingFloorMultiple     Float
  updatedAt                DateTime @updatedAt
  updatedById              String?
}

// ─── Module release switch (super-user) ─────────────────────────────────────
/// On/off flag per platform module, so a super user can build in the background
/// and release modules when ready. Absent row = enabled (default on).
model ModuleFlag {
  key       String   @id // e.g. "benefits", "knowledge"
  enabled   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt
}

// ─── Branding (white-label per deployment, super-user) ──────────────────────
/// Single-row brand identity for this deployment: company name, logo, and the two
/// base colors (primary + accent) that re-theme the whole UI. Defaults to Forefront
/// navy/gold; when unchanged, no theme override is injected (identical look).
model BrandSettings {
  id           String   @id @default("singleton")
  companyName  String   @default("Forefront People") // official/legal name
  platformName String? // what shows in-app (wordmark); falls back to companyName
  shortName    String   @default("Forefront") // eyebrow / initial
  logoUrl      String?
  primaryColor String   @default("#0f2444") // navy-800
  accentColor  String   @default("#c9a227") // gold-500
  updatedAt    DateTime @default(now()) @updatedAt
}

// ─── Business Units (multi-brand, spec 024) ─────────────────────────────────
/// A group company an employee belongs to, carrying its own brand (name, logo,
/// primary + accent colors). The app theme follows the VIEWING user's business
/// unit; unset falls back to the BrandSettings default. Theming only — no data
/// isolation (that is spec 022's full multi-tenancy). Distinct from Department.
model BusinessUnit {
  id              String             @id @default(cuid())
  name            String             @unique // official company name; unique (case-insensitive enforced in app)
  platformName    String? // what shows in-app (wordmark); falls back to name
  shortName       String // eyebrow / initial
  logoUrl         String? // private Blob URL; null = wordmark
  primaryColor    String             @default("#0f2444") // navy-800
  accentColor     String             @default("#c9a227") // gold-500
  order           Int                @default(0)
  // The unit used as the default/fallback brand (unassigned users, sign-in, app
  // icon). At most one unit is default; enforced by the setDefault action.
  isDefault       Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt
  members         User[]
  /// Which copies of which messages this unit branded (spec 039).
  brandedMessages MessageRecipient[]

  /// Finance (2026-08-25): each unit banks separately, so each has its own appointed confirmers
  /// and its own submissions.
  transactionConfirmers TransactionConfirmer[] @relation("TransactionConfirmerUnit")
  paymentBatches        PaymentBatch[]         @relation("PaymentBatchUnit")
}

// ─── Notification settings (super-user, spec 020) ───────────────────────────
/// Single-row config for the claim-workflow emails. Non-secret only: the master
/// on/off toggle, the HR and Finance team inboxes, and the outgoing from-name.
/// The Resend API key and sender address live in env (RESEND_API_KEY, EMAIL_FROM),
/// never here. With emails off or unconfigured the workflow still runs; nothing is sent.
model NotificationSettings {
  id                   String   @id @default("singleton")
  emailEnabled         Boolean  @default(false)
  hrInbox              String?
  financeInbox         String?
  fromName             String?
  /// Days before a holiday that HR is asked to confirm its date (spec 037 FR-015).
  verificationLeadDays Int      @default(14)
  /// How many days before a birthday or joining anniversary the platform prepares the draft
  /// (spec 039 FR-018). Mirrors verificationLeadDays above rather than inventing a second idiom.
  congratsLeadDays     Int      @default(3)
  updatedAt            DateTime @default(now()) @updatedAt
}

// ─── Profile change requests (spec 029) ─────────────────────────────────

/// The outcome of one requested field. The decision lives on the FIELD, not the request,
/// because HR decides field by field — one request can be part approved, part declined.
enum ProfileFieldStatus {
  PENDING
  APPROVED
  DECLINED
}

/// An employee's proposal to correct their own record. It is only an envelope: it groups the
/// fields submitted together and carries the employee's reason. A request is "open" while any
/// of its fields is still PENDING — there is no status column to drift out of step with them.
model ProfileChangeRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("ChangeRequester", fields: [userId], references: [id], onDelete: Cascade)

  /// Optional context from the employee ("she remarried and changed her number").
  reason String?

  fields ProfileChangeField[]

  createdAt DateTime @default(now())

  @@index([userId])
}

/// One field inside a request: which field, the value proposed for it, and — once HR decides —
/// the decision, who made it and when.
///
/// The value is TEXT for every field (a date is an ISO yyyy-mm-dd, an enum its member name).
/// Approving parses it and writes the typed column, so adding a requestable field later is a
/// registry entry rather than a migration. The CURRENT value is deliberately not stored: it is
/// read at review time (FR-010), so approving can never silently revert an edit HR made while
/// the request sat in the queue.
model ProfileChangeField {
  id        String               @id @default(cuid())
  requestId String
  request   ProfileChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// Registry key — see src/lib/profile/requestable.ts.
  field          String
  /// The proposed value, serialised. Empty string means "clear this field".
  requestedValue String

  status         ProfileFieldStatus @default(PENDING)
  /// Why HR declined. Shown to the employee against this field.
  decisionReason String?
  decidedById    String?
  decidedBy      User?              @relation("FieldDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?

  createdAt DateTime @default(now())

  /// A field appears at most once per request, so two rows can never propose different values
  /// for the same column.
  @@unique([requestId, field])
  @@index([status])
}

/// A per-person decision about ONE cycle's pool ceiling (2026-08-20).
///
/// Exists because a ceiling can shrink under money already spent — HR lowers a configured amount,
/// corrects an employment type or start date, or re-dates a cycle — and those must stay possible.
/// The resulting overrun is surfaced on the Benefits report, and resolved here.
///
/// RAISED   `amount` becomes this person's ceiling for this cycle, authorising the spend instead of
///          reversing it. SUPER USER ONLY: it permits spending past a money rule, so it sits with
///          governance rather than with HR Admin.
/// ACCEPTED the numbers are left exactly as they are and the report stops flagging the row. A record
///          of the decision, not a change to it.
///
/// One row per person per cycle — a later decision replaces the earlier one, and `reason` is
/// required either way, because the point is the record.
model PoolCeilingException {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation("PoolExceptionSubject", fields: [userId], references: [id], onDelete: Cascade)
  planYearId  String
  planYear    PlanYear          @relation(fields: [planYearId], references: [id], onDelete: Cascade)
  kind        PoolExceptionKind
  /// The ceiling for this person this cycle. Set for RAISED, null for ACCEPTED.
  amount      Int?
  reason      String
  createdById String?
  createdBy   User?             @relation("PoolExceptionActor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, planYearId])
  @@index([planYearId])
}

enum PoolExceptionKind {
  RAISED
  ACCEPTED
}

// ─── Learning Track (spec 038) ──────────────────────────────────────────
// HR authors courses and routes them to employees; employees work through them with
// tracked progress. The employee registry is the ONLY source of people — this module
// adds no account, no sign-up and no role.
//
// Naming: the middle hierarchy level is `CourseSection`, never `Module` (ModuleFlag
// already means "app area" here), and nothing here is called `Announcement`.

enum LearningCourseStatus {
  DRAFT // never been live — still being built. Invisible to employees, including by direct link.
  PUBLISHED // live; who actually sees it is `visibility` plus the course's access rules
  /// Paused. Was live, and is meant to be live again — but right now NOBODY can open it, including
  /// people who were halfway through. Nothing is deleted: every lesson tick and watched second is
  /// kept and comes straight back when it is made visible again.
  ///
  /// Behaviourally this is what returning to DRAFT already did. It exists because the two mean
  /// different things to an operator reading a list of courses — "unfinished" and "temporarily off
  /// the shelf" are not the same thing, and calling a course that ran for a year a Draft is a lie.
  HIDDEN
}

enum LearningVisibility {
  OPEN // every active employee
  RESTRICTED // only people an access route reaches
}

enum LessonBlockType {
  VIDEO
  TEXT
  FILE
}

/// How a course is routed to people. Stored as a RULE and resolved live against the
/// registry, never expanded into membership rows — that is what makes a new joiner pick
/// up their courses with no HR action (spec 038 FR-014).
enum AudienceKind {
  ALL_ACTIVE
  DEPARTMENT
  BUSINESS_UNIT
  EMPLOYMENT_TYPE
  TENURE_BAND
  REPORTS_TO
}

/// Where a lesson's video lives. Stored rather than re-derived on read, so the server can
/// check trackability without re-parsing a URL. There is deliberately no UPLOAD member:
/// video is linked, never hosted (spec 038 research D8). DRIVE plays but exposes no
/// playback API, so it can carry no watch gate and no checkpoint.
enum VideoSource {
  YOUTUBE
  VIMEO
  DRIVE
  DIRECT_FILE
}

model Course {
  id               String               @id @default(cuid())
  title            String
  summary          String?
  /// Private blob URL, streamed like every other image in the app.
  coverBlobUrl     String?
  category         String?
  status           LearningCourseStatus @default(DRAFT)
  visibility       LearningVisibility   @default(RESTRICTED)
  /// Optional renewal period in months. NULL (the default) = completion is permanent. When set,
  /// a completion older than this is treated as lapsed and the course returns to the learner's
  /// list. Lapsing is DERIVED from the completion date, never a stored flag and never a scheduled
  /// job, so nothing can be missed or run twice.
  renewAfterMonths Int?
  order            Int                  @default(0)
  publishedAt      DateTime?

  createdById String?
  createdBy   User?   @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("CourseUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  sections    CourseSection[]
  audiences   CourseAudience[]
  assignments CourseAssignment[]
  enrollments CourseEnrollment[]
  documents   CourseDocument[]
  resources   CourseResource[]
  ratings     CourseRating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([order])
}

model CourseSection {
  id        String    @id @default(cuid())
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  deletedAt DateTime?

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model Lesson {
  id               String        @id @default(cuid())
  sectionId        String
  section          CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title            String
  order            Int
  /// Only REQUIRED lessons count toward the course percentage (spec 038 FR-004/FR-022).
  isRequired       Boolean       @default(true)
  estimatedMinutes Int?
  /// Gate completion until this % of the lesson's video is watched. 0 = no gate.
  /// Refused for a DRIVE video, which reports no playback (FR-031).
  minWatchPercent  Int           @default(0)
  /// The video's real length, learned from the first person to watch it — nobody types it in.
  /// Null until someone has played it, and forever on a source that reports no playback.
  /// `estimatedMinutes` still wins when an author has deliberately set one.
  videoDurationSec Int?
  /// Soft delete: removing a lesson must leave everyone's completions meaningful.
  deletedAt        DateTime?

  blocks      LessonBlock[]
  checkpoints VideoCheckpoint[]
  progress    LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
}

model LessonBlock {
  id            String          @id @default(cuid())
  lessonId      String
  lesson        Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type          LessonBlockType
  order         Int
  /// TEXT only — sanitised SERVER-SIDE before storage, because it is rendered as HTML.
  text          String?
  /// FILE only — a private blob URL. Never a video: the platform hosts no video.
  blobUrl       String?
  /// VIDEO only — the external source, with `videoSource` recording which it is.
  externalUrl   String?
  videoSource   VideoSource?
  fileName      String?
  fileSizeBytes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
}

/// A question shown at a moment in a lesson's video: playback pauses until it is answered.
/// Answers are NEVER stored — this is a comprehension device, not an assessment (FR-032).
model VideoCheckpoint {
  id           String   @id @default(cuid())
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  atSec        Int
  prompt       String
  options      String[]
  correctIndex Int
  createdAt    DateTime @default(now())

  @@index([lessonId])
}

/// One routing rule on a course. Rules on the same course UNION (a person matching any of
/// them is reached). `value` is interpreted per `kind`: the department label, a
/// BusinessUnit id, an EmploymentType, a TenureBand, or the manager's User id; null for
/// ALL_ACTIVE. A TENURE_BAND rule is compiled to a startDate RANGE, never to the stored
/// (and possibly stale) User.tenureBand column — see lib/learning/audience.ts.
model CourseAudience {
  id       String       @id @default(cuid())
  courseId String
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind     AudienceKind
  value    String?

  createdById String?
  createdBy   User?    @relation("AudienceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([courseId, kind, value])
  @@index([courseId])
}

/// A named, reusable cohort for the cases no registry field describes ("2026 new joiners").
model LearnerGroup {
  id   String @id @default(cuid())
  name String @unique

  createdById String?
  createdBy   User?   @relation("LearnerGroupCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members     LearnerGroupMember[]
  assignments CourseAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LearnerGroupMember {
  id      String       @id @default(cuid())
  groupId String
  group   LearnerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User         @relation("GroupMemberSubject", fields: [userId], references: [id], onDelete: Cascade)

  addedById String?
  addedBy   User?    @relation("GroupMemberAdder", fields: [addedById], references: [id], onDelete: SetNull)
  addedAt   DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

/// A grant of access to one course, to EITHER one employee or one group — exactly one of
/// `userId`/`groupId` is set. Revocation is a stamp, never a delete, so the trail survives.
/// Granting does NOT enrol: enrollment happens when the employee first opens the course,
/// which is what makes "never started ⇒ lose access immediately" expressible (FR-045).
model CourseAssignment {
  id       String        @id @default(cuid())
  courseId String
  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?         @relation("CourseAssignmentSubject", fields: [userId], references: [id], onDelete: Cascade)
  groupId  String?
  group    LearnerGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  grantedById String?
  grantedBy   User?     @relation("CourseAssignmentActor", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@unique([courseId, userId])
  @@unique([courseId, groupId])
  @@index([courseId, revokedAt])
  @@index([userId])
  @@index([groupId])
}

/// One employee's participation in one course. Created on FIRST OPEN, not on assignment.
///
/// This row is itself an ACCESS ROUTE: while `completedAt` and `accessWithdrawnAt` are both
/// null the learner is mid-course and keeps access even after every other route is gone
/// (FR-042). Nothing is written when a route is removed — the rule reads this state — so no
/// route-removal path can forget to grandfather someone.
///
/// There is deliberately NO progressPercent column: the percentage is computed from
/// LessonProgress, so it can never disagree with the rows it summarises.
model CourseEnrollment {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("EnrollmentLearner", fields: [userId], references: [id], onDelete: Cascade)

  startedAt        DateTime  @default(now())
  /// Null while in progress. Cleared (not erased) when required content is added and HR
  /// chooses to reopen — `firstCompletedAt` keeps the original date.
  completedAt      DateTime?
  firstCompletedAt DateTime?
  reopenedAt       DateTime?
  /// How many times this person has completed the course. Only moves for a RENEWAL cycle, so a
  /// reopened-and-refinished course is still one completion.
  completionCount  Int       @default(0)

  /// HR ending grandfathered access (FR-043/FR-044). Refused unless the enrollment is
  /// CURRENTLY grandfathered, so it can never strip access held by a real route.
  accessWithdrawnAt   DateTime?
  accessWithdrawnById String?
  accessWithdrawnBy   User?     @relation("AccessWithdrawer", fields: [accessWithdrawnById], references: [id], onDelete: SetNull)

  /// Resume hint only. The authority is the first incomplete lesson over progress rows.
  lastLessonId String?

  /// The `completionCount` the finish panel (rating + suggest a resource) has already been
  /// answered or skipped for. The panel shows while `completionCount > ratingPromptDoneCount`,
  /// so skipping is durable and a RENEWAL asks again on its own — no flag to reset and no job.
  ratingPromptDoneCount Int @default(0)

  lessonProgress LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, userId])
  @@index([userId])
  @@index([courseId])
}

/// One learner's state on one lesson. Keyed by LESSON ID, never position, so reordering or
/// renaming a curriculum can never move anyone's percentage (FR-023).
model LessonProgress {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completedAt      DateTime?
  lastPositionSec  Int?
  /// Credited watched seconds. Only ever INCREASES — advanced with SQL GREATEST so seeking
  /// backward cannot reduce it and two open tabs cannot lose an update (FR-028).
  videoWatchedSec  Int       @default(0)
  /// The video's length as the player reported it, kept so the SERVER can check the watch gate
  /// (watched / duration >= minWatchPercent) instead of trusting a percentage from the client.
  /// Also only ever increases, for the same reason. Note this figure still ORIGINATES from the
  /// player — the gate stops someone clicking past training, not someone determined to forge it.
  videoDurationSec Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
}

// ── Course materials (spec 038 materials, 2026-08-22) ──────────────────────────────────

/// The three documents a course carries. Fixed SLOTS, not a free file list: a course either
/// has its outline or it does not, and a named slot says so at a glance instead of making
/// somebody read filenames. Only SLIDES is ever served to an employee — that rule lives in
/// `src/lib/learning/materials.ts` and in the serving route, never in a page.
enum CourseDocumentSlot {
  OUTLINE
  EXPANDED_OUTLINE
  SLIDES
}

enum CourseResourceKind {
  BOOK
  ARTICLE
  COURSE
  VIDEO
  LINK
}

/// PENDING is an employee's suggestion awaiting HR. Only PUBLISHED rows are ever shown to
/// anybody but HR, so a suggestion cannot reach the library by being forgotten about.
enum CourseResourceStatus {
  PENDING
  PUBLISHED
  DECLINED
}

model CourseDocument {
  id       String             @id @default(cuid())
  courseId String
  course   Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slot     CourseDocumentSlot

  /// Private blob URL, streamed through the server like every other file in the app.
  blobUrl     String
  fileName    String
  contentType String?
  sizeBytes   Int?

  uploadedById String?
  uploadedBy   User?   @relation("CourseDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One document per slot per course — replacing is an upsert, so a course can never end up
  /// with two "Slides" and no way to tell which one employees are getting.
  @@unique([courseId, slot])
}

/// Reading and links recommended alongside a course. A type, a name, and a link WHEN THERE IS
/// ONE — a book usually has no URL, which is why `url` is nullable rather than required.
model CourseResource {
  id       String               @id @default(cuid())
  courseId String
  course   Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind     CourseResourceKind
  name     String
  url      String?
  status   CourseResourceStatus @default(PUBLISHED)
  order    Int                  @default(0)

  /// Set when an employee proposed this rather than HR adding it. Kept after approval so the
  /// library visibly grows from people, and so HR can see who is contributing.
  suggestedById String?
  suggestedBy   User?   @relation("CourseResourceSuggester", fields: [suggestedById], references: [id], onDelete: SetNull)

  reviewedById String?
  reviewedBy   User?     @relation("CourseResourceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, status])
  @@index([status])
}

/// One person's rating of one course, 1–5.
///
/// ANONYMITY, stated honestly: `userId` is stored because it is the only way to avoid asking the
/// same person twice and to keep one person to one score. It is NEVER exposed — no query in this
/// app selects it for display, and HR sees only the average and the count. Renewing a course
/// UPDATES this row rather than adding one, so a person can never be counted twice in an average.
model CourseRating {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("CourseRater", fields: [userId], references: [id], onDelete: Cascade)

  stars           Int
  /// Which completion this score was given for, so a renewal's re-rating is distinguishable
  /// from the original in the row's history.
  completionIndex Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, userId])
  @@index([courseId])
}

/// An appointment to run the Learning module — NOT a role on the employee record.
///
/// The person stays an `EMPLOYEE`; holding a row here opens Admin → Learning and nothing else.
/// Doing it this way rather than as a `Role` member is what keeps it from ever leaking into
/// Benefits, salaries or Time-Off: there is no new role for another module's check to misread, and
/// the employee form does not change.
///
/// HR Admins and Super Users are NOT listed here — they hold Learning because they hold
/// everything. `canManageLearning` unions the two, so nobody can lock HR out of the module by
/// emptying this table.
model LearningManager {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("LearningManagerSubject", fields: [userId], references: [id], onDelete: Cascade)

  /// Who appointed them. Only an HR Admin or Super User can write this row — a learning manager
  /// appointing another one would let the role hand itself out.
  appointedById String?
  appointedBy   User?   @relation("LearningManagerAppointer", fields: [appointedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ─── Finance: petty cash & payback requests (spec 040) ──────────────────
//
// Replaces the MARCOM Expenses workbook. A petty cash account is a FLOAT held by a named
// custodian: Finance tops it up, the custodian's spend draws it down, and each period closes
// with one arithmetic that says who owes whom. Separately, anybody who paid out of pocket
// raises a payback request with evidence for Finance to approve and pay.
//
// MONEY: every amount here is `Decimal(10,2)` EGP and is read into TypeScript through
// `src/lib/finance/money.ts` ONLY — integer piastres for arithmetic, never floats.
// DERIVATION: balances and period figures come from `src/lib/finance/pettycash.ts` and are
// never stored, so no screen can quote a total that disagrees with another.

enum PettyCashAccountStatus {
  ACTIVE
  ARCHIVED
}

enum PettyCashPeriodStatus {
  OPEN // the custodian is logging spend
  SUBMITTED // handed to Finance for review; Finance may still edit, the custodian may not
  CLOSED // figures frozen; evidence may still be attached, amounts may not change
}

/// FLOAT draws on the custodian's cash. COMPANY_TRANSFER is the company paying a vendor
/// directly — it counts as period expenditure and consumes budget, but never moves the float.
enum PettyCashPaymentMethod {
  FLOAT
  COMPANY_TRANSFER
}

/// Cash moving between the company and the float. The amount is ALWAYS positive; the type
/// carries the direction, so a negative amount can never mean two different things.
enum PettyCashFundingType {
  TOP_UP // company → custodian
  RETURN // custodian → company
}

/// Spec 040 inserts PAYMENT_SUBMITTED between APPROVED and PAID (a request becomes PAID when
/// the CEO approves the run carrying it, not when Finance records the transfer).
/// DO NOT reorder these members.
enum PaybackStatus {
  SUBMITTED
  APPROVED
  /// Sent to the bank in a batch, waiting on the confirmer (spec 041). A request reaches PAID
  /// only when that batch is confirmed — not when Finance records the transfer.
  PAYMENT_SUBMITTED
  REJECTED
  PAID
}

/// A float held by ONE named custodian. Carries no balance column on purpose: the balance is
/// derived from fundings and float-paid lines, so it cannot drift from the lines that explain
/// it. The row is also the lock subject — every write that could race takes it FOR UPDATE.
model PettyCashAccount {
  id     String                 @id @default(cuid())
  name   String                 @unique
  status PettyCashAccountStatus @default(ACTIVE)

  /// The person who holds the cash. Must be an ACTIVE employee for new lines to be accepted —
  /// an account whose custodian has left is frozen until Finance names a new one.
  custodianId String
  custodian   User   @relation("PettyCashCustodian", fields: [custodianId], references: [id])

  createdById String?
  createdBy   User?   @relation("PettyCashAccountCreator", fields: [createdById], references: [id], onDelete: SetNull)

  periods  PettyCashPeriod[]
  fundings PettyCashFunding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([custodianId])
  @@index([status])
}

/// One reconciliation window on one account. `openingBalance` is the previous period's closing
/// balance, carried forward as a first-class figure rather than the workbook's hand-typed
/// "December Overbudget" line.
///
/// An account may have at most ONE open period. Prisma cannot express a partial unique index,
/// so it lives in `prisma/sql/067_petty_cash_payback.sql`.
model PettyCashPeriod {
  id        String           @id @default(cuid())
  accountId String
  account   PettyCashAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  label     String /// e.g. "Aug 2026"
  startDate DateTime
  endDate   DateTime

  /// Optional per-period budget. Remaining budget is derived and SIGNED — an overspend shows
  /// as an overspend and is never floored to zero.
  budget Decimal? @db.Decimal(10, 2)

  /// Carried from the previous period's closing balance (0 for the first). Signed.
  openingBalance Decimal @default(0) @db.Decimal(10, 2)

  status PettyCashPeriodStatus @default(OPEN)

  submittedAt   DateTime?
  submittedById String?
  submittedBy   User?     @relation("PettyCashPeriodSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  closedAt   DateTime?
  closedById String?
  closedBy   User?     @relation("PettyCashPeriodCloser", fields: [closedById], references: [id], onDelete: SetNull)

  /// Closing a period that still has lines with no receipt requires Finance to acknowledge
  /// those specific lines. We store WHICH lines were acknowledged, not just that a box was
  /// ticked — otherwise the acknowledgement says nothing about what was accepted.
  missingEvidenceAckAt      DateTime?
  missingEvidenceAckById    String?
  missingEvidenceAckBy      User?     @relation("PettyCashMissingEvidenceAck", fields: [missingEvidenceAckById], references: [id], onDelete: SetNull)
  missingEvidenceAckNote    String?
  missingEvidenceAckLineIds String[]  @default([])

  reopenedAt   DateTime?
  reopenedById String?
  reopenedBy   User?     @relation("PettyCashPeriodReopener", fields: [reopenedById], references: [id], onDelete: SetNull)
  reopenReason String?

  lines    PettyCashLine[]
  fundings PettyCashFunding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, label])
  @@index([accountId, startDate])
  @@index([status])
}

/// Cash moving into or out of the float. Recorded by Finance only.
model PettyCashFunding {
  id        String           @id @default(cuid())
  accountId String
  account   PettyCashAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// The period it counts toward — set explicitly, like a line, so a figure can never move
  /// between periods because somebody corrected a date.
  periodId String?
  period   PettyCashPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  type      PettyCashFundingType
  date      DateTime
  amount    Decimal              @db.Decimal(10, 2) /// always positive; `type` carries direction
  reference String? /// bank / InstaPay reference
  note      String?

  recordedById String?
  recordedBy   User?   @relation("PettyCashFundingRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  batchItems PaymentBatchItem[]

  createdAt DateTime @default(now())

  @@index([accountId, date])
  @@index([periodId])
}

/// One purchase. Belongs to a period explicitly (never by date window): the workbook's lines
/// are routinely undated or dated outside their tab, and a line that silently moves between
/// periods changes a balance somebody already signed off.
model PettyCashLine {
  id       String          @id @default(cuid())
  periodId String
  period   PettyCashPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  datePaid DateTime

  sectionId String
  section   ExpenseSection @relation(fields: [sectionId], references: [id])

  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  description    String
  method         PettyCashPaymentMethod
  paymentDetails String? /// the workbook's free-text "Payment details"
  payee          String? /// the workbook's "TO"
  amount         Decimal                @db.Decimal(10, 2)

  createdById String?
  createdBy   User?   @relation("PettyCashLineCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// A line is "missing receipt" when this is empty — derived, never a stored flag.
  evidence ExpenseEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([periodId])
  @@index([sectionId])
  @@index([categoryId])
  @@index([datePaid])
}

/// What a deleted line said. A ledger where a row can simply vanish is not a ledger.
model PettyCashLineDeletion {
  id       String @id @default(cuid())
  periodId String

  /// The line's fields as they stood, including its evidence filenames.
  snapshot Json

  deletedById String?
  deletedBy   User?    @relation("PettyCashLineDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedAt   DateTime @default(now())

  @@index([periodId])
}

/// Somebody's out-of-pocket spend awaiting repayment. Open to every employee — a custodian's
/// own overspend is settled through petty cash reconciliation, not through here.
model PaybackRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("PaybackRequester", fields: [userId], references: [id], onDelete: Cascade)

  amount   Decimal  @db.Decimal(10, 2)
  datePaid DateTime

  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  description String
  payee       String?

  status      PaybackStatus @default(SUBMITTED)
  submittedAt DateTime      @default(now())

  decidedById    String?
  decidedBy      User?     @relation("PaybackDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  decisionReason String? /// required on rejection

  /// The payment as recorded by Finance. `paidAt` is when it was RECORDED; `transferDate` is
  /// when the money moved — they are different questions and the workbook conflated them.
  paidById          String?
  paidBy            User?     @relation("PaybackPayer", fields: [paidById], references: [id], onDelete: SetNull)
  paidAt            DateTime?
  transferDate      DateTime?
  amountTransferred Decimal?  @db.Decimal(10, 2)
  paymentReference  String?

  evidence   ExpenseEvidence[]
  batchItems PaymentBatchItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/// A receipt or invoice. ONE model with two optional parents, because a spend line and a
/// payback request carry the same kind of file under the same rules — one upload validator,
/// one serving route, one access rule. Exactly one parent is set, enforced by a check
/// constraint in the migration (Prisma cannot express it).
///
/// Files live in the PRIVATE blob store and are only ever reachable through
/// `/api/expense-evidence/[id]`, which re-decides access at the door and answers 404 — never
/// 403, which would confirm the file exists.
model ExpenseEvidence {
  id String @id @default(cuid())

  /// Where the file actually lives. EXACTLY ONE of these is set (enforced by a check
  /// constraint, `ExpenseEvidence_one_location`):
  ///   • `blobUrl` — uploaded here, served through /api/expense-evidence/[id] after the
  ///     entitlement check, and private.
  ///   • `externalUrl` — the receipt lives somewhere else and always did. The marketing
  ///     workbook's receipts are Google Drive links, so importing its history (spec 040,
  ///     migration 073) had nothing to upload. The same route answers, makes the same
  ///     decision, and REDIRECTS instead of streaming — so there is still one door, and
  ///     still 404 rather than 403 for anyone not entitled. Whoever follows it needs
  ///     access to the file in Drive; the platform cannot grant that.
  blobUrl     String?
  externalUrl String?
  fileName    String
  contentType String
  sizeBytes   Int

  uploadedById String?
  uploadedBy   User?   @relation("ExpenseEvidenceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  pettyCashLineId String?
  pettyCashLine   PettyCashLine? @relation(fields: [pettyCashLineId], references: [id], onDelete: Cascade)

  paybackRequestId String?
  paybackRequest   PaybackRequest? @relation(fields: [paybackRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([pettyCashLineId])
  @@index([paybackRequestId])
}

/// Admin-managed classification. Sections and categories are INDEPENDENT flat lists — the
/// workbook pairs them freely and leaves category blank half the time — so a line requires a
/// section and may carry a category, and neither constrains the other.
model ExpenseSection {
  id         String    @id @default(cuid())
  name       String    @unique
  sortOrder  Int       @default(0)
  /// Archived values stay on the records that already reference them; they are simply no
  /// longer offered on new ones.
  archivedAt DateTime?

  lines PettyCashLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExpenseCategory {
  id         String    @id @default(cuid())
  name       String    @unique
  sortOrder  Int       @default(0)
  archivedAt DateTime?

  lines           PettyCashLine[]
  paybackRequests PaybackRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Finance: bank confirmations & salary runs (spec 041) ──────────────
//
// The bank releases money on two signatures: Finance enters a transfer, the CEO confirms it.
// This is NOT an approval gate — the gate is the bank's. These tables are the notification and
// the record: what Finance sent, what it totalled, who confirmed it, and when.

enum PaymentBatchType {
  EXPENSES
  SALARY
}

/// The words are the CEO's own (2026-08-24). Finance CREATES a transaction in the bank and
/// submits it here for confirmation; he confirms it in the bank, and marks it COMPLETE — the
/// transaction is done, the money has moved. Nothing here "approves" or "sends" anything.
enum PaymentBatchStatus {
  SUBMITTED // created in the bank, submitted here for confirmation — the only state that waits
  COMPLETE // confirmed in the bank; the money has moved. Immutable
  RETURNED // handed back to Finance with a note; its items are released
  WITHDRAWN // Finance pulled it back before a decision; its items are released
}

/// Who may confirm a batch.
///
/// UNLIKE `LearningManager`, holding HR Admin or Super User does NOT confer this implicitly.
/// That is deliberate and was the CEO's instruction: payments wait for him and nobody else, and
/// an implicit power held by every top-level account would make that promise false. The lock-out
/// this pattern normally guards against is covered instead by letting a Super User appoint
/// THEMSELVES — an empty table is a pause, not a wall. Do not "fix" this into consistency.
model TransactionConfirmer {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("TransactionConfirmerSubject", fields: [userId], references: [id], onDelete: Cascade)

  /// WHICH UNIT they confirm for (added 2026-08-25 at the CEO's instruction: "we need it by
  /// business unit — every business unit might have an account to confirm and accordingly
  /// different people"). Each unit banks separately, so the appointment is per unit and one
  /// person may hold several. There is deliberately NO row meaning "all units": a company-wide
  /// appointment would silently cover a unit created next month.
  businessUnitId String
  businessUnit   BusinessUnit @relation("TransactionConfirmerUnit", fields: [businessUnitId], references: [id], onDelete: Cascade)

  /// Only a Super User can write this row — an appointed confirmer appointing another one would
  /// let the appointment hand itself out.
  appointedById String?
  appointedBy   User?   @relation("TransactionConfirmerAppointer", fields: [appointedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([userId, businessUnitId])
  @@index([businessUnitId])
}

/// The transactions Finance created in the bank in one sitting, submitted here for confirmation.
///
/// NOTE ON WORDS: the UI never calls this a "batch" — screens say "3 transactions". The model
/// name is internal shorthand only. It is created ALREADY SUBMITTED: there is no draft, because
/// it records something that already exists in the bank.
model PaymentBatch {
  id        String             @id @default(cuid())
  reference String /// human-facing, e.g. "AUG-26-01"
  type      PaymentBatchType
  status    PaymentBatchStatus @default(SUBMITTED)

  /// WHOSE BANK ACCOUNT this was created in (2026-08-25). Derived at submission from the people
  /// being paid — never typed in — and a submission may only ever hold payables from this one
  /// unit, because it corresponds to one transaction in one account. It also decides who is
  /// emailed and whose queue it appears in.
  businessUnitId String
  businessUnit   BusinessUnit @relation("PaymentBatchUnit", fields: [businessUnitId], references: [id])

  bankReference String?
  valueDate     DateTime
  note          String?

  /// FROZEN AT SUBMISSION, and the one figure in this module that is stored rather than derived.
  /// The confirmer acts on the number he was emailed, possibly hours earlier; recomputing it on
  /// read would let the emailed figure and the confirmed figure diverge at exactly the moment it
  /// matters. Items are locked while the batch stands, so it cannot go stale either.
  totalAmount Decimal @db.Decimal(10, 2)
  itemCount   Int

  submittedById String?
  submittedBy   User?    @relation("PaymentBatchSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime @default(now())

  decidedById  String?
  decidedBy    User?     @relation("PaymentBatchDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String? /// required when returning to Finance or withdrawing

  /// What the confirmer was shown at the moment he confirmed. Equal to `totalAmount` by
  /// construction — stored so "what did he actually confirm?" is answerable without inference.
  confirmedTotal Decimal? @db.Decimal(10, 2)

  // ── Salary runs only ──
  /// First day of the month covered. Null for an expenses batch.
  salaryMonth    DateTime?
  headcount      Int?
  isExtraRun     Boolean   @default(false)
  extraRunReason String?

  attachmentUrl  String?
  attachmentName String?

  items PaymentBatchItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([submittedAt])
  @@index([businessUnitId, status])
}

/// One payable inside a batch. Two optional parents, exactly one set (check constraint in SQL).
///
/// The payee, purpose and amount are SNAPSHOTS taken at submission, so the record of what was
/// actually created in the bank survives a later correction to the source record.
model PaymentBatchItem {
  id      String       @id @default(cuid())
  batchId String
  batch   PaymentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  paybackRequestId String?
  paybackRequest   PaybackRequest? @relation(fields: [paybackRequestId], references: [id], onDelete: SetNull)

  pettyCashFundingId String?
  pettyCashFunding   PettyCashFunding? @relation(fields: [pettyCashFundingId], references: [id], onDelete: SetNull)

  /// Benefit-claim reimbursements travel the same path (added 2026-08-24 at the CEO's note): the
  /// employee is told when HE confirms at the bank, not when Finance records a transfer.
  benefitClaimId String?
  benefitClaim   BenefitClaim? @relation(fields: [benefitClaimId], references: [id], onDelete: SetNull)

  amountAtSubmission Decimal @db.Decimal(10, 2)
  payeeName          String
  purpose            String

  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([benefitClaimId])
}

/// One row per reminder email, so a daily job cannot pester somebody twice about the same batch
/// on the same day — and so "was he actually told?" is answerable.
model ConfirmationReminderLog {
  id      String   @id @default(cuid())
  batchId String
  userId  String
  sentOn  DateTime @db.Date

  createdAt DateTime @default(now())

  @@unique([batchId, userId, sentOn])
}

// ─── Team Communications (spec 039, 2026-08-24) ─────────────────────────────────────────

/// What a message is. The kind decides who it reaches and who may send it: an ANNOUNCEMENT goes
/// to an audience and is written by a person; a congratulation goes to exactly ONE person and is
/// prepared by the platform, then edited and sent by a human.
enum MessageKind {
  ANNOUNCEMENT
  BIRTHDAY
  WORK_ANNIVERSARY
}

/// DRAFT is the only state that can be edited or sent.
///
/// MISSED is terminal and deliberate: a congratulation nobody sent CLOSES rather than going out
/// late (FR-026). You cannot wish somebody a happy birthday three days afterwards, and a system
/// that tries is worse than one that stays quiet.
enum MessageState {
  DRAFT
  SENT
  MISSED
}

/// What the mail provider said about ONE person's copy. PENDING exists for the window between the
/// row being written and the provider answering — so a function that dies mid-send leaves evidence
/// of who it was up to rather than a gap nobody can reconstruct.
enum DeliveryState {
  PENDING
  ACCEPTED
  FAILED
}

/// One thing that goes to people.
model Message {
  id      String       @id @default(cuid())
  kind    MessageKind
  state   MessageState @default(DRAFT)
  subject String
  /// Plain text. Blank lines become paragraphs — the composer is a textarea, so the line breaks
  /// somebody typed are the only structure the message has.
  body    String

  /// Optional call to action. Rendered ONLY when the href is absolute: a relative link is dead in
  /// a mail client, which has no page to be relative to.
  ctaLabel String?
  ctaHref  String?

  /// The person a congratulation is ABOUT. Null for an announcement.
  subjectUserId String?
  subjectUser   User?   @relation("MessageSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  /// Whose queue it sits in — the line manager, or HR. Null for an announcement.
  assignedToId String?
  assignedTo   User?   @relation("MessageAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// Null when the PLATFORM prepared it rather than a person writing it.
  createdById String?
  createdBy   User?   @relation("MessageAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  /// Who pressed send. Stored rather than derived: this is what the closing line is signed with
  /// (FR-023), and it must not change when the person later changes role or manager.
  sentById String?
  sentBy   User?   @relation("MessageSender", fields: [sentById], references: [id], onDelete: SetNull)

  sentAt   DateTime?
  missedAt DateTime?

  /// Stamped AT SEND. A snapshot of what was true then, never recomputed — a live count would
  /// answer "who would this reach today", which is a different and misleading question once
  /// people have joined or left.
  recipientCount Int @default(0)

  audiences  MessageAudience[]
  recipients MessageRecipient[]
  occasion   Occasion?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, kind])
  @@index([assignedToId, state])
  @@index([subjectUserId])
}

/// One person's copy of one message. This table is why "did Karim get it?" is answerable.
model MessageRecipient {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation("MessageAddressee", fields: [userId], references: [id], onDelete: Cascade)

  /// The address AS IT WAS at send time. People change email; the record has to say where the
  /// message actually went, not where it would go today.
  email String

  /// Which unit branded THIS copy — the reason two people can receive the same words looking
  /// different. Records the unit, not its colour: a unit re-branding changes future emails and
  /// must not rewrite the past.
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)

  state      DeliveryState @default(PENDING)
  /// The provider's id for this ONE message, for chasing a specific delivery later.
  providerId String?
  /// Why this one failed, when it did.
  error      String?

  createdAt DateTime @default(now())

  /// A person cannot be in one send twice, however the audience choices overlap. Somebody matched
  /// by their department AND by name gets one email, not two.
  @@unique([messageId, userId])
  @@index([messageId, state])
}

/// For an announcement: one row per choice, exactly mirroring how a course stores its access.
///
/// Deliberately NOT an expanded list of people — a choice is a RULE resolved live, which is what
/// makes the count on screen today's answer rather than a stale one. The expansion happens once,
/// at send, and lands in MessageRecipient.
///
/// There is deliberately no ALL_ACTIVE value. "Everyone" is its own control on the picker, for
/// the reason the Learning fix established: two ways to say everyone is how a restricted thing
/// quietly reaches the whole company.
model MessageAudience {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// DEPARTMENT | GROUP | PERSON | BUSINESS_UNIT | TENURE_BAND | EMPLOYMENT_TYPE | REPORTS_TO
  field     String
  value     String

  createdAt DateTime @default(now())

  @@unique([messageId, field, value])
}

/// A birthday or joining anniversary for one person in one year.
///
/// Its only job is to make idempotence STRUCTURAL. The unique index below IS the guarantee that a
/// second preparation run creates nothing new — not a check the job has to remember to do.
model Occasion {
  id     String      @id @default(cuid())
  userId String
  user   User        @relation("OccasionSubject", fields: [userId], references: [id], onDelete: Cascade)
  kind   MessageKind // BIRTHDAY or WORK_ANNIVERSARY

  occasionYear Int
  /// The OBSERVED date — 28 February in a non-leap year for a 29 February birthday, so three
  /// people in four years do not silently get nothing.
  occasionDate DateTime

  /// Years of service. NULL for a birthday — an age is never stated (FR-020), and a nullable
  /// column is how the model refuses to hold one rather than merely declining to print it.
  years Int?

  messageId String?  @unique
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  preparedAt DateTime @default(now())

  @@unique([userId, kind, occasionYear])
  @@index([occasionDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// Performance reviews & 1:1s (spec 040)
//
// This module is private to each manager↔report pair. HR Admins and Super Users
// read NOTHING here — not the contents and not the existence — and there is no
// break-glass. Two consequences are visible in the shapes below:
//
//   1. Every record STORES its pair (`employeeId` + `managerId`) and is
//      authorised against those two ids, never against the live org chart. This
//      is the deliberate opposite of the Time-Off rule (`pendingApprovalWhere`
//      resolves approvals against the CURRENT chart, on purpose) — a leave
//      request must reach whoever can approve it today, but a review belongs to
//      the two people who had it, so a new manager never inherits the previous
//      manager's conversations.
//
//   2. `JournalEntry` has no relation to any sheet, pair or manager. There is no
//      join by which another person's entry can be reached, so leaking one would
//      have to be written deliberately rather than by forgetting a filter.
//
// There is no ReviewCycle table: a quarter is derived from the calendar
// (`src/lib/reviews/quarters.ts`), because nobody opens or closes one.
// ─────────────────────────────────────────────────────────────────────────────

enum ReviewJournalSection {
  WENT_WELL
  DIDNT_GO_WELL
  LEARNING
  BLOCKER
  EXPECTATION
}

enum ReviewItemSource {
  TYPED
  JOURNAL
  ONE_ON_ONE
  STRENGTH
}

enum StrengthsDomain {
  EXECUTING
  INFLUENCING
  RELATIONSHIP_BUILDING
  STRATEGIC_THINKING
}

enum StrengthsProfileSource {
  PARSED
  MANUAL
}

/// One review per pair per quarter.
///
/// The seal: both halves stay hidden from each other until BOTH parties have
/// submitted AND BOTH have confirmed the meeting happened. Submitting means "I
/// am ready to meet", not "you may read me". Requiring both confirmations is
/// what stops one party unsealing the other's half by declaring a meeting that
/// never took place.
///
/// A quarter that ends with `openedAt` still null stays sealed forever: no
/// outcome, no carry-forward, nothing published. A review that did not happen
/// leaves no record that it did.
model ReviewSheet {
  id      String @id @default(cuid())
  year    Int
  quarter Int // 1–4

  employeeId String
  employee   User   @relation("ReviewSheetEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  /// Their manager AT THE TIME THE SHEET WAS CREATED. Access is checked against
  /// this, not against `User.reportsToId` as it stands today.
  managerId  String
  manager    User   @relation("ReviewSheetManager", fields: [managerId], references: [id], onDelete: Cascade)

  employeeSubmittedAt    DateTime?
  managerSubmittedAt     DateTime?
  employeeMetConfirmedAt DateTime?
  managerMetConfirmedAt  DateTime?

  /// Stamped once all four timestamps above are present, under a row lock so two
  /// simultaneous confirmations cannot both read "not yet complete". This single
  /// field is what every read and write consults: visible and frozen are the
  /// same state, deliberately — the halves are what each person BROUGHT to the
  /// meeting, and the meeting's own content belongs in the outcome.
  openedAt DateTime?

  items   ReviewSheetItem[]
  outcome ReviewOutcome?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A mid-quarter manager change produces a SECOND sheet rather than a
  /// collision — which is correct, because it is a different pair.
  @@unique([year, quarter, employeeId, managerId])
  @@index([employeeId, year, quarter])
  @@index([managerId, year, quarter])
}

/// Every answer on the agenda is a LIST — the source template is bullets and
/// numbered lists throughout — so one table holds all of them.
///
/// `body` is always a COPY. Editing or deleting the journal entry it came from,
/// or replacing the author's strengths profile, cannot reach it. That is why a
/// strengths pick stores the theme NAME rather than a foreign key.
model ReviewSheetItem {
  id      String      @id @default(cuid())
  sheetId String
  sheet   ReviewSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  /// Which half this belongs to — always the sheet's employee or manager.
  authorId String
  author   User   @relation("ReviewItemAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// From the agenda registry in `src/lib/reviews/agenda.ts` — code, not a table:
  /// there is no operator for this module, so an editable question table would be
  /// a screen nobody is allowed to have.
  questionKey String
  position    Int
  body        String

  sourceKind ReviewItemSource @default(TYPED)
  /// The journal entry or 1:1 it was promoted from; the theme code for STRENGTH.
  sourceId   String?

  createdAt DateTime @default(now())
  // A partial unique index on (sheetId, authorId, questionKey, sourceKind, sourceId)
  // WHERE sourceId IS NOT NULL makes re-promoting the same source a no-op. Prisma
  // cannot express a partial index — it lives in prisma/sql/067.

  @@index([sheetId, authorId])
}

/// The only thing that outlives the meeting, and the next quarter's carry-forward.
model ReviewOutcome {
  id      String      @id @default(cuid())
  sheetId String      @unique
  sheet   ReviewSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  priorities          String
  risks               String
  successDefinition   String
  employeeCommitments String
  managerCommitments  String

  authoredById String
  authoredBy   User   @relation("ReviewOutcomeAuthor", fields: [authoredById], references: [id], onDelete: Cascade)

  employeeAckAt DateTime?
  managerAckAt  DateTime?
  /// Stamped when both acknowledgements are present. Only a final outcome carries
  /// forward. Any edit before this clears BOTH acks — nobody's agreement should
  /// stay attached to text they never saw.
  finalAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Private to its author, permanently. Deliberately joined to nothing.
model JournalEntry {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation("JournalAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// The day it happened — not the day it was typed.
  occurredOn DateTime
  section    ReviewJournalSection?
  body       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, occurredOn])
}

/// An ad-hoc conversation, held whenever it is needed rather than waiting for the
/// quarter. Nothing is sealed here — the value of a 1:1 is being quick — but the
/// outcome needs both parties to acknowledge it, and then the record freezes.
model OneOnOne {
  id String @id @default(cuid())

  employeeId String
  employee   User   @relation("OneOnOneEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  managerId  String
  manager    User   @relation("OneOnOneManager", fields: [managerId], references: [id], onDelete: Cascade)

  heldOn      DateTime
  createdById String
  createdBy   User     @relation("OneOnOneCreator", fields: [createdById], references: [id], onDelete: Cascade)

  outcome       String?
  employeeAckAt DateTime?
  managerAckAt  DateTime?
  finalAt       DateTime?

  notes OneOnOneNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, heldOn])
  @@index([managerId, heldOn])
}

model OneOnOneNote {
  id         String   @id @default(cuid())
  oneOnOneId String
  oneOnOne   OneOnOne @relation(fields: [oneOnOneId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("OneOnOneNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body     String

  createdAt DateTime @default(now())

  @@index([oneOnOneId])
}

/// The fixed CliftonStrengths vocabulary — 34 rows, seeded by the migration, not
/// by a screen. `name` is the exact spelling Gallup prints, which is what the PDF
/// parser matches against and what a sheet item stores.
model StrengthsTheme {
  code      String          @id
  name      String          @unique
  domain    StrengthsDomain
  sortOrder Int

  profileThemes StrengthsProfileTheme[]
}

/// One employee's own ordered themes. An ordered list of any length covers both a
/// Top 5 report and a CliftonStrengths 34 report, so there is no "which report
/// type" setting to get wrong.
///
/// The uploaded PDF is employee-record data, NOT part of the private review
/// module: HR uploads it and confirms the themes, and it is served through an
/// authorising route that answers 404 (never 403) to anyone else.
model StrengthsProfile {
  id         String @id @default(cuid())
  employeeId String @unique
  employee   User   @relation("StrengthsProfileSubject", fields: [employeeId], references: [id], onDelete: Cascade)

  source         StrengthsProfileSource @default(PARSED)
  /// As printed in the report footer.
  assessmentDate DateTime?
  /// The name as PRINTED in the report, shown at confirmation so a report uploaded
  /// against the wrong person is caught. Never used to match an employee
  /// automatically — extraction kerning produced "ISLAM SA ADANY" in a real sample.
  printedName    String?

  blobUrl  String?
  fileName String?

  confirmedById String
  confirmedBy   User     @relation("StrengthsProfileConfirmer", fields: [confirmedById], references: [id], onDelete: Cascade)
  /// Nothing is saved before a human confirms the extracted themes.
  confirmedAt   DateTime @default(now())

  themes StrengthsProfileTheme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StrengthsProfileTheme {
  id        String           @id @default(cuid())
  profileId String
  profile   StrengthsProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  rank      Int
  themeCode String
  theme     StrengthsTheme @relation(fields: [themeCode], references: [code], onDelete: Cascade)

  @@unique([profileId, rank])
  @@unique([profileId, themeCode])
  @@index([profileId])
}
